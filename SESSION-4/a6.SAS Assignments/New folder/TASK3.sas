DATA MED_RELAGARE;
SET SSN4.MED_RELAGARE;
KEEP CUSTOMER_ID COMPANY GENDER	Age	STATE_CODE	Spent_amount;
WHERE STATE_CODE IN ('NSW' 'QLD' 'WA') AND GENDER='Female' AND Age>35;
RUN;
PROC PRINT DATA=MED_RELAGARE;RUN;	
		

/* STEP-1 */
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN4.ACCOUNT_PERFORMANCE_MASTER
			DATAFILE='/home/u61735472/BATCH_202203/A4.SESSION-4/RAW DATA/TASK_5_DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='ACCOUNT_PERFORMANCE';
RUN;
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN4.EMPLOYER_MASTER
			DATAFILE='/home/u61735472/BATCH_202203/A4.SESSION-4/RAW DATA/TASK_5_DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='EMPLOYER_DETAILS';
RUN;	
/* STEP-2 */
DATA SSN4.ACCOUNT_MODEL(KEEP=Account_number	PORTFOLIO	SSN	Phone_No_ 	Place_Name	County	City	State	Zip	Region	Account_Open_Date	Last_payment_date	Loan_amount	loan_status	Origination_fico_score	Current_fico_score	Current_outstanding	CUSTOMER_NUMBER	COMPANY_NAME	PRIMARY_INDUSTRY	REVENUES__IN_MILLIONS_DOLLAR_ CATEGORY);
MERGE SSN4.ACCOUNT_PERFORMANCE_MASTER (IN=X) 	SSN4.EMPLOYER_MASTER (IN=Y)	;
BY Account_number;
IF X=1;
RUN;

/* STEP-3,4,5,6,7,8*/
DATA SSN4.ACCOUNT_MODEL_V1; 
SET SSN4.ACCOUNT_MODEL;
MOB=INTCK('MONTH',Account_Open_Date,TODAY());
/* DELINQUENCY_DAYS */
IF loan_status='Non-Default' THEN DELINQUENCY_DAYS=INTCK('DAY',Last_payment_date,TODAY());
ELSE  DELINQUENCY_DAYS=0;
/* DELINQUENCY_BUCKET */
FORMAT DELINQUENCY_BUCKET $15.;
IF DELINQUENCY_DAYS=0 THEN DELINQUENCY_BUCKET='CURRENT';
ELSE IF DELINQUENCY_DAYS<=30 THEN DELINQUENCY_BUCKET='X DAYS';
ELSE IF (30<DELINQUENCY_DAYS<=60) THEN DELINQUENCY_BUCKET='X+1 DAYS';
ELSE IF (60<DELINQUENCY_DAYS<=90) THEN DELINQUENCY_BUCKET='X+2 DAYS';
ELSE IF (90<DELINQUENCY_DAYS<=120) THEN DELINQUENCY_BUCKET='X+3 DAYS';
ELSE IF (120<DELINQUENCY_DAYS<=150) THEN DELINQUENCY_BUCKET='X+4 DAYS';
ELSE IF (150<DELINQUENCY_DAYS<=180) THEN DELINQUENCY_BUCKET='X+5 DAYS';
ELSE DELINQUENCY_BUCKET='CHARGE OFF';
/* CREATE ORIGINATION VS CURRECT FICO SCORE VARIANCE IN % */
FORMAT SCORE_VARIANCE PERCENTN8.2;
SCORE_VARIANCE=(Origination_fico_score-Current_fico_score)/Origination_fico_score;
/* CURRENT OUTSTANDING BALANCE IN % */
FORMAT CURRENT_OUTSTANDING_BALANCE PERCENT6.;
CURRENT_OUTSTANDING_BALANCE=Current_outstanding/Loan_amount;
/* DEVELOP RISK SEGMENT */
IF DELINQUENCY_DAYS<=60 AND SCORE_VARIANCE<0 THEN DO;
		IF CURRENT_OUTSTANDING_BALANCE>=0.5 THEN RISK_SEGMENT='High_Risk_1';
		ELSE IF (0.3<CURRENT_OUTSTANDING_BALANCE<0.5) THEN RISK_SEGMENT='High_Risk_3';
		ELSE IF (0.1<CURRENT_OUTSTANDING_BALANCE<=0.3) THEN RISK_SEGMENT='MID_Risk_1';
		ELSE RISK_SEGMENT='Low_risk';
END;
ELSE IF DELINQUENCY_DAYS>60 AND SCORE_VARIANCE<0 THEN DO;
		IF CURRENT_OUTSTANDING_BALANCE>=0.5 THEN RISK_SEGMENT='High_Risk_2';
		ELSE IF (0.3<CURRENT_OUTSTANDING_BALANCE<0.5) THEN RISK_SEGMENT='High_Risk_4';
		ELSE IF (0.1<CURRENT_OUTSTANDING_BALANCE<=0.3) THEN RISK_SEGMENT='MID_Risk_2';
		ELSE RISK_SEGMENT='Low_risk';
END;	
ELSE RISK_SEGMENT='Low_risk';
RUN;
	
/* STEP-9 */
/* CREATE SUMMARY REPORT FOR ALL DIFFERENT PORTFOLIOS */
PROC SQL;
CREATE TABLE SSN4.ACCOUNT_MODEL_FINAL AS
SELECT *,
CASE 
	WHEN Loan_status='Non-Default' THEN Current_outstanding/(SELECT SUM(Current_outstanding) FROM SSN4.ACCOUNT_MODEL_V1 WHERE Loan_status='Non-Default')
END AS GOOD_LPA FORMAT=PERCENT15.10,
CASE 
	WHEN Loan_status='Default' THEN Current_outstanding/(SELECT SUM(Current_outstanding) FROM SSN4.ACCOUNT_MODEL_V1 WHERE Loan_status='Default')
END AS BAD_LPA FORMAT=PERCENT15.10
FROM SSN4.ACCOUNT_MODEL_V1
GROUP BY Account_number,PORTFOLIO,SSN,Phone_No_,Place_Name,
	County,City,State,Zip,Region,Account_Open_Date,
	Loan_amount,Loan_status,Last_payment_date,Origination_fico_score,
	Current_fico_score,Current_outstanding,CUSTOMER_NUMBER,COMPANY_NAME,
	PRIMARY_INDUSTRY,REVENUES__IN_MILLIONS_DOLLAR_,CATEGORY	,
	MOB,DELINQUENCY_DAYS,DELINQUENCY_BUCKET,SCORE_VARIANCE,
	CURRENT_OUTSTANDING_BALANCE,RISK_SEGMENT;  
QUIT;

PROC EXPORT DATA=SSN4.ACCOUNT_MODEL_FINAL
			OUTFILE='/home/u61735472/BATCH_202203/A4.SESSION-4/OUTPUT/FINAL.XLSX'
			DBMS=XLSX REPLACE;
			SHEET='CCC';
RUN;			
			




		
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN4.COUNTRY_SALES
			DATAFILE='/home/u61735472/BATCH_202203/A4.SESSION-4/RAW DATA/SAS Session-4 Assignments.xlsx'
			DBMS=XLSX REPLACE;
			RANGE='SALES';
RUN;

/* Q1 GET COUNTRY WISE MARKET SHARE IN %*/

PROC SQL;
CREATE TABLE TABLE1 AS
SELECT COUNTRY,TOTAL_SALES,
TOTAL_SALES/(SELECT SUM(SALES) FROM SSN4.COUNTRY_SALES) AS COUNTRY_WISE_MS FORMAT=PERCENT12.4
FROM 
(SELECT COUNTRY,
SUM(SALES) AS TOTAL_SALES
/* SALES/(SELECT SUM(SALES) FROM SSN4.COUNTRY_SALES) AS COUNTRY_WISE_MS FORMAT=PERCENT12.4 */
FROM SSN4.COUNTRY_SALES
GROUP BY COUNTRY);
QUIT;
PROC PRINT DATA=TABLE1 ;RUN;

/* Q2	GET COUNTRY AND SEGMENT WISE MARKET SHARE IN % */

PROC SQL;
CREATE TABLE TAB2 AS
SELECT A.COUNTRY,A.SEGMENT,
SUM(A.SALES) AS TOT_SALES,
SUM(A.SALES)/B.CO_SALES AS MS FORMAT PERCENT12.3
FROM SSN4.COUNTRY_SALES AS A 
LEFT JOIN
(
	SELECT COUNTRY,
	SUM(SALES) AS CO_SALES FROM SSN4.COUNTRY_SALES
	GROUP BY COUNTRY
)AS B
ON A.COUNTRY=B.COUNTRY
GROUP BY A.COUNTRY,A.SEGMENT,B.CO_SALES;
QUIT;
PROC PRINT DATA=TAB2;RUN;

/* Q3	GET COUNTRY,SEGMENT AND CATEGORY WISE MARKET SHARE IN % */
PROC SQL;
CREATE TABLE TAB4 AS
SELECT A.COUNTRY,A.SEGMENT,A.CATEGORY,
SUM(A.SALES) AS TOT_SALES,
SUM(A.SALES)/B.CO_SALES AS MS FORMAT=PERCENT12.2
FROM SSN4.COUNTRY_SALES AS A
LEFT JOIN
(
	SELECT 	COUNTRY ,SEGMENT,
	SUM(SALES) AS CO_SALES FROM SSN4.COUNTRY_SALES
	GROUP BY COUNTRY ,SEGMENT
)AS B
ON A.COUNTRY=B.COUNTRY
AND
A.SEGMENT=B.SEGMENT
GROUP BY A.COUNTRY,A.SEGMENT,A.CATEGORY,B.CO_SALES
;
QUIT;
PROC PRINT DATA=TAB4;RUN;



























































































			
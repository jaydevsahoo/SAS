/* INNER JOIN */
PROC SQL;
CREATE TABLE PROD_V1 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
INNER JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
;
QUIT;
PROC PRINT DATA=PROD_V1;RUN;

/* FULL JOIN */
PROC SQL;
CREATE TABLE PROD_V2 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
FULL JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
;
QUIT;
PROC PRINT DATA=PROD_V2;RUN;

/* UNMATCHED JOIN */
PROC SQL;
CREATE TABLE PROD_V3 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
FULL JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
WHERE A.UNITS IS NULL OR B.PRICE IS NULL
;
QUIT;
PROC PRINT DATA=PROD_V3;RUN;

/* LEFT JOIN */
PROC SQL;
CREATE TABLE PROD_V4 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
LEFT JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
;
QUIT;
PROC PRINT DATA=PROD_V4;RUN;

/* RIGHT JOIN */
PROC SQL;
CREATE TABLE PROD_V5 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
RIGHT JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
;
QUIT;
PROC PRINT DATA=PROD_V5;RUN;

/* LEFT NULL */
PROC SQL;
CREATE TABLE PROD_V5 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
LEFT JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
WHERE B.PRICE IS NULL;
;
QUIT;
PROC PRINT DATA=PROD_V5;RUN;

/* RIGHT NULL */
PROC SQL;
CREATE TABLE PROD_V5 AS
SELECT A.PRODUCT,A.CITY,A.YEAR,A.UNITS,B.PRODUCT AS PD,B.CITY AS CT,B.YEAR AS YR,B.PRICE FROM 
SSN4.PROD_UNITS AS A 
RIGHT JOIN
SSN4.PROD_PRICE AS B 
ON A.PRODUCT=B.PRODUCT
AND
A.CITY=B.CITY
AND
A.YEAR=B.YEAR
WHERE A.UNITS IS NULL;
;
QUIT;
PROC PRINT DATA=PROD_V5;RUN;















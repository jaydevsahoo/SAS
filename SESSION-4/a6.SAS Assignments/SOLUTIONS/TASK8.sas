PROC SQL;
CREATE TABLE DATA_MODEL2 AS 
SELECT A.Order_ID,A.Cust_ID,B.Gender,B.Age,A.Prod_ID,C.Prod_Name,C.Category,
C.Price,A.Vendor_ID,D.Vendor_Name,D.Location,D.State,D.Country,D.Region,
A.Order_Day,A.Order_Month,E.Qtr,A.Order_Year,A.Order_Date,A.Order_Yearmo,A.Units,
A.Units*C.Price AS SALES FROM 
SSN4.Sales as A LEFT JOIN SSN4.Customer AS B 
ON A.Cust_ID=B.Cust_ID 
LEFT JOIN SSN4.Product AS C
ON A.Prod_ID=C.Prod_ID 
LEFT JOIN SSN4.Vendor AS D 
ON A.Vendor_ID=D.Vendor_ID
LEFT JOIN SSN4.Time AS E 
ON A.Order_Month=E.Month
ORDER BY 1
;
QUIT;

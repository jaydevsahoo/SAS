			SHEET='PEN_SALES';
RUN;
PROC PRINT DATA=SSN4.PEN_SALES;RUN;
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN4.REFILL_SALES
			DATAFILE='/home/u61735472/BATCH_202203/A4.SESSION-4/RAW DATA/B5.Data Model Class-5.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='REFILL_SALES';
RUN;			
PROC PRINT DATA=SSN4.REFILL_SALES;RUN;
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN4.MAPPING
			DATAFILE='/home/u61735472/BATCH_202203/A4.SESSION-4/RAW DATA/B5.Data Model Class-5.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='MAPPING';
RUN;			
PROC PRINT DATA=SSN4.MAPPING;RUN;
			
PROC SQL;
CREATE TABLE DATA_MODEL5 AS
SELECT A.PEN,A.COUNTRY,A.YEARMO,A.SALES,
B.PEN AS MAP_PEN,B.REFILL,B.WEIGHTAGE,
C.REFILL AS SUPP_REFILL,C.COUNTRY AS SUPP_COUNTRY,C.YEARMO AS SUPP_YEARMO,C.SALES AS SUPP_SALES,
C.SALES*B.WEIGHTAGE AS SUPPLIES_TO_PEN
FROM SSN4.PEN_SALES AS A 
LEFT JOIN 
SSN4.MAPPING AS B
ON A.PEN=B.PEN
LEFT JOIN
SSN4.REFILL_SALES AS C 
ON B.REFILL=C.REFILL
ORDER BY 3
;
QUIT;
PROC PRINT DATA=DATA_MODEL5;RUN;













































PROC SQL NUMBER;
CREATE TABLE DATA_MODEL1 AS 
SELECT A.Order_ID,A.Order_Date,A.Cust_ID,B.Age,B.Area,
A.Prod_ID,C.Prod_Name,C.Category,C.Price,A.Units,
C.Price*A.Units AS SALES FROM 
SSN4.Sales_tbl AS A 
LEFT JOIN 
SSN4.Customer_tbl AS B 
ON A.Cust_ID=B.Cust_ID
LEFT JOIN
SSN4.Prod_tbl AS C 
ON A.Prod_ID=C.Prod_ID
ORDER BY 1
;
QUIT;
PROC PRINT DATA=DATA_MODEL1;RUN;



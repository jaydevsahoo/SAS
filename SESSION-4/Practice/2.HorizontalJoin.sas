/* EX-1 */
LIBNAME SSN3 '/home/u61735472/BATCH_202203/A3.SESSION-3/DATASET';RUN;
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN3.STU_DETAILS
			DATAFILE='/home/u61735472/BATCH_202203/A3.SESSION-3/RAW DATA/JOININGS/HORIZONTAL DATA/A3.HORIZONTAL JOIN DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='STU_EDUCATION';
RUN;			
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN3.STU_EXPERIENCE
			DATAFILE='/home/u61735472/BATCH_202203/A3.SESSION-3/RAW DATA/JOININGS/HORIZONTAL DATA/A3.HORIZONTAL JOIN DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='STU_EXPERIENCE';
RUN;			

/* INNER JOIN */
DATA STU_V1;
MERGE SSN3.STU_DETAILS (IN=X) SSN3.STU_EXPERIENCE (IN=Y);
BY STU_ID;
IF X=1 AND Y=1;
RUN;
PROC PRINT DATA=STU_V1;RUN;

/* FULL JOIN */
DATA STU_V2;
MERGE SSN3.STU_DETAILS(IN=X) SSN3.STU_EXPERIENCE (IN=Y);
BY STU_ID;
IF X=1 OR Y=1;
RUN;
PROC PRINT DATA=STU_V2;RUN;

/* LEFT JOIN */
DATA STU_V3;
MERGE SSN3.STU_DETAILS (IN=X) SSN3.STU_EXPERIENCE (IN=Y);
BY STU_ID;
IF X=1;
RUN;
PROC PRINT DATA=STU_V3;RUN;

/* RIGHT JOIN */
DATA STU_V4;
MERGE SSN3.STU_DETAILS (IN=X) SSN3.STU_EXPERIENCE (IN=Y);
BY STU_ID;
IF Y=1;
RUN;
PROC PRINT DATA=STU_V4;RUN;

/* UNMATCHED JOIN */
DATA STU_V6;
MERGE SSN3.STU_DETAILS (IN=X) SSN3.STU_EXPERIENCE (IN=Y);
BY STU_ID;
IF X=0 OR Y=0;
RUN;
PROC PRINT DATA=STU_V6;RUN;

/* LEFT NULL */
DATA STU_V7;
MERGE SSN3.STU_DETAILS (IN=X) SSN3.STU_EXPERIENCE (IN=Y);
BY STU_ID;
IF X=1 AND Y=0;
RUN;
PROC PRINT DATA=STU_V7;RUN;

/* OR */
PROC SQL;
CREATE TABLE STU_V7_1 AS
SELECT A.*,B.* FROM 
SSN3.STU_DETAILS AS A
LEFT JOIN
SSN3.STU_EXPERIENCE AS B 
ON A.STU_ID=B.STU_ID
WHERE B.STU_ID IS NULL;
QUIT;
PROC PRINT DATA=STU_V7_1;RUN;

/* RIGHT NULL */
DATA STU_V8;
MERGE SSN3.STU_DETAILS (IN=X) SSN3.STU_EXPERIENCE(IN=Y);
BY STU_ID;
IF X=0 AND Y=1;
RUN;
PROC PRINT DATA=STU_V8;RUN;


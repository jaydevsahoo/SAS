/* =============UNION & UNION ALL============== */
PROC SQL;
CREATE TABLE MED_ALL AS
SELECT * FROM SSN3.MED_APPOLO 
UNION ALL
SELECT * FROM SSN3.MED_CIPLA 
QUIT;
/* OR */
/* Note that the PROC APPEND procedure doesn’t create a new data set. */
PROC APPEND BASE=SSN3.MED_APPOLO DATA=SSN3.MED_CIPLA ;
RUN;
/* OR */
DATA MED_ALL;
SET SSN3.MED_APPOLO 
	SSN3.MED_CIPLA;
RUN;
PROC PRINT 	DATA=MED_ALL;RUN;
/* DO FOR ALL */
DATA MED_ALL;
SET MED_ALL SSN3.MED_GENO SSN3.MED_RELEGARE SSN3.MED_GSK;
RUN;
PROC PRINT 	DATA=MED_ALL;RUN;


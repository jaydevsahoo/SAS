PROC SQL;
CREATE TABLE SCORE AS
SELECT * FROM SSN3.SCORE1
UNION
SELECT * FROM SSN3.SCORE2
QUIT;
PROC PRINT DATA=SCORE;RUN;			

/* OR */
PROC SORT DATA=SSN3.SCORE1;
BY STU_NAME;
RUN;
PROC PRINT DATA=SSN3.SCORE1;
PROC SORT DATA=SSN3.SCORE2;
BY STU_NAME;
RUN;
PROC PRINT DATA=SSN3.SCORE2;
/* UNION SCORE */

DATA SCORE_ALL;
FORMAT STU_NAME $15. SUBJECT $15.;
SET SSN3.SCORE1 SSN3.SCORE2;
RUN;

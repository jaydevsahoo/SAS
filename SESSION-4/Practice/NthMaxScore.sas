DATA STU_SCORE;
INFILE CARDS DLM=',' DSD MISSOVER;
INPUT NAME :$ 15. SCORE;
CARDS ;
TONY,300
STARK,600
STEVE,400
ROGERS,300
HULK,700
;
RUN;
PROC PRINT DATA=STU_SCORE;RUN;

PROC SQL;
CREATE TABLE MAX_SCORER AS
SELECT A.NAME,A.SCORE FROM STU_SCORE AS A 
WHERE (SELECT COUNT(DISTINCT B.SCORE) FROM STU_SCORE AS B WHERE B.SCORE>=A.SCORE)=4
;
QUIT;
PROC PRINT DATA=MAX_SCORER;RUN;












































































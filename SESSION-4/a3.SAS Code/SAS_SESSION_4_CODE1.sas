PROC SQL;
SELECT 
A.STU_ID,
A.STU_NAME,
A.GENDER,
A.EDUCATION,
B.STU_ID,
B.YOE,
B.COMPANY,
B.SALARY
FROM STU_EDUCATION AS A
INNER JOIN
STU_OCCUPATION AS B
ON
A.STU_ID=B.STU_ID;
QUIT;

/* FULL JOIN- IT TAKES ALL THE COMMON AND UN-COMMON RECORDS FROM BOTH THE TABLE */

DATA STU_ALL_INFO;
MERGE STU_EDUCATION (IN=A) STU_OCCUPATION (IN=B) ;
BY STU_ID;
IF A OR B;

/* INNER JOIN- IT TAKES ALL THE COMMON RECORDS FROM BOTH THE TABLE */

DATA STU_ALL_INFO;
MERGE STU_EDUCATION (IN=A) STU_OCCUPATION (IN=B) ;
BY STU_ID;

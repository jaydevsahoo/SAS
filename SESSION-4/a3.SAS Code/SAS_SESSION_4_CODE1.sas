/* WE WILL DESIGN THIS DATA MODEL */
/* WHERE WE HAVE DATASETS LIKE */
/* 1. TRANSACTION MASTER */
/* 2. CUSTOMER MASTER */
/* 3. PRODUCT MASTER */
/* 4. STORE MASTER */
/* 5. STAFF MASTER */
/*  */
/* IN THIS  */
/* 1. TRANSACTION MASTER IS THE FACT TABLE HAVING REFERENCE KEYS (FOREIGN KEYS) */
/* 2. CUSTOMER MASTER IS THE DIMENSION TABLE-1 HAVING PRIMARY KEY */
/* 3. PRODUCT MASTER IS THE DIMENSION TABLE-2 HAVING PRIMARY KEY */
/* 4. STORE MASTER IS THE DIMENSION TABLE-3 HAVING PRIMARY KEY */
/* 5. STAFF MASTER IS THE DIMENSION TABLE-4 HAVING PRIMARY KEY */
/*  */
/* RELATIONSHIP IN THIS DATA MODEL */
/*  */
/* TRANSACTION_MASTER.CUST_ID=CUSTOMER_MASTER.CUST_ID */
/* TRANSACTION_MASTER.PROD_ID=PRODUCT_MASTER.PROD_ID */
/* TRANSACTION_MASTER.STORE_ID=STORE_MASTER.STORE_ID */
/* TRANSACTION_MASTER.STAFF_ID=STAFF_MASTER.STAFF_ID */

/* IN THIS DATA MODEL */
/* WE HAVE 1 FACT TABLE */
/* AND */
/* 4 DIMENSION TABLES  */
/* AND */
/* ALL THE DIMENSION TABLES MAPPED TO FACT TABLE */
/* HENCE THIS TYPE OF DATA MODEL IS CALLED STAR SCHEMA */


/* DESIGNING THE DATA MODEL */

PROC SQL NUMBER;
CREATE TABLE SSN4.DATA_MODEL1
AS
SELECT
A.ORDER_ID,
A.ORDER_DT,
A.CUST_ID,
B.CUST_NAME,
B.DOB,
B.MOBILE,
A.PROD_ID,
C.PROD_NAME,
C.CATEGORY,
C.PRICE,
C.QTY AS INVENTORY,
C.SUPPLIER_ID,
A.QTY,
A.STORE_ID,
D.STORE_NAME,
D.LOCATION,
A.STAFF_ID,
E.STAFF_NAME,
E.DESIGNATION,
E.YOE,
(A.QTY*C.PRICE) AS SALES
FROM SSN4.TRANSACTION_MASTER AS A
LEFT JOIN
SSN4.CUSTOMER_MASTER AS B
ON
A.CUST_ID=B.CUST_ID
LEFT JOIN
SSN4.PRODUCT_MASTER AS C
ON
A.PROD_ID=C.PROD_ID
LEFT JOIN
SSN4.STORE_MASTER AS D
ON

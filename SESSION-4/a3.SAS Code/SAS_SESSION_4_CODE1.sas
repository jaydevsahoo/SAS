/* GET SOLVED THESE 2 QUESTIONS */

/* 1. GET COUNTRY AND YEAR WISE PRODUCT SALES AND ITS MARKET SHARE */
/* 2. GET PRODUCT AND YEAR WISE SALES BY COUNTRIES AND THEIR MARKET SHARE */


/* 1. GET COUNTRY AND YEAR WISE PRODUCT SALES AND ITS MARKET SHARE */

PROC SQL;
SELECT
A.COUNTRY,
A.YEAR,
A.LAPTOP,
A.SALES,
B.TOTAL_SALES,
(A.SALES/B.TOTAL_SALES) AS COUNTRY_PRODUCT_MS FORMAT=PERCENT10.2
FROM LAPTOP_SALES AS A
LEFT JOIN
	(SELECT 
	COUNTRY, 
	YEAR, 
	SUM(SALES) AS TOTAL_SALES 
	FROM LAPTOP_SALES 
	GROUP BY COUNTRY, YEAR) AS B
ON
A.COUNTRY=B.COUNTRY
AND
A.YEAR=B.YEAR
ORDER BY 1,2,6 DESC;
QUIT;

/* 2. GET PRODUCT AND YEAR WISE SALES BY COUNTRIES AND THEIR MARKET SHARE */

PROC SQL;
SELECT
A.LAPTOP,
A.YEAR,
A.COUNTRY,
A.SALES,
B.TOTAL_SALES,
(A.SALES/B.TOTAL_SALES) AS COUNTRY_PRODUCT_MS FORMAT=PERCENT10.2
FROM LAPTOP_SALES AS A
LEFT JOIN
	(SELECT 
	LAPTOP, 
	YEAR, 
	SUM(SALES) AS TOTAL_SALES 
	FROM LAPTOP_SALES 
	GROUP BY LAPTOP, YEAR) AS B
ON
A.LAPTOP=B.LAPTOP
AND
A.YEAR=B.YEAR
ORDER BY 1,2,6 DESC;
QUIT;


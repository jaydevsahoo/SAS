/* IN THIS DATA MODEL */
/* WE HAVE  */
/* TRANSACTION_MASTER IS THE FACT TABLE */
/* CUSTOMER_MASTER IS THE DIMENSION TABLE-1 */
/* PRODUCT_MASTER IS THE DIMENSION TABLE-2 */
/* STORE_MASTER IS THE DIMENSION TABLE-3 */
/* STAFF_MASTER IS THE DIMENSION TABLE-4 */
/* SUPPLIER_MASTER IS THE DIMENSION TABLE-5 */
/*  */
/* SUPPLIER_MASTER IS NOT DIRECTLY CONNECTED TO THE FACT TABLE */
/* IT GOES FROM SUPPLIER TO PRODUCT AND THEN PRODUCT TO TRANSACTION MASTER TABLE */


PROC SQL NUMBER;
CREATE TABLE SSN4.DATA_MODEL2
AS
SELECT
A.ORDER_ID,
A.ORDER_DT,
A.CUST_ID,
B.CUST_NAME,
B.DOB,
B.MOBILE,
A.PROD_ID,
C.PROD_NAME,
C.CATEGORY,
C.PRICE,
C.QTY AS INVENTORY,
C.SUPPLIER_ID,
F.SUPPLIER_NAME,
F.LOCATION,
F.CONTACT,
A.QTY,
A.STORE_ID,
D.STORE_NAME,
D.LOCATION,
A.STAFF_ID,
E.STAFF_NAME,
E.DESIGNATION,
E.YOE,
(A.QTY*C.PRICE) AS SALES
FROM SSN4.TRANSACTION_MASTER AS A
LEFT JOIN
SSN4.CUSTOMER_MASTER AS B
ON
A.CUST_ID=B.CUST_ID
LEFT JOIN
SSN4.PRODUCT_MASTER AS C
ON
A.PROD_ID=C.PROD_ID
LEFT JOIN
SSN4.STORE_MASTER AS D
ON
A.STORE_ID=D.STORE_ID
LEFT JOIN
SSN4.STAFF_MASTER AS E
ON
A.STAFF_ID=E.STAFF_ID
LEFT JOIN
SSN4.SUPPLIER_MASTER AS F
ON
C.SUPPLIER_ID=F.SUPPLIER_ID;
QUIT;


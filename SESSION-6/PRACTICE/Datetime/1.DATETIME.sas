DATA DATES;
CURRENT_DAY1=TODAY() ;
CURRENT_DAY2=DATE() ;
CURRENT_DATETIME=DATETIME();
CURRENT_DAY=DAY(TODAY());
CURRENT_MONTH=MONTH(TODAY());
CURRENT_YEAR=YEAR(TODAY());
YEARMONTH=YEAR(TODAY())*100+MONTH(TODAY());
GET_DATE=MDY(MONTH(TODAY()),DAY(TODAY()),YEAR(TODAY()));
CURRENT_HOUR=HOUR(DATETIME());
CURRENT_MINUTE=MINUTE(DATETIME());
CURRENT_SEC=SECOND(DATETIME());
FORMAT CURRENT_DAY1 CURRENT_DAY2 GET_DATE  DDMMYY10. CURRENT_DATETIME DATETIME40.;
RUN;
PROC PRINT;RUN;


/* DATE DIFFERENCE */
DATA DATES2;
DOB='14APR93'D;
TODAY=TODAY();
FORMAT DOB TODAY DDMMYY10.;
YEAR_DIFF=INTCK('YEAR',DOB,TODAY);
MONTH_DIFF=INTCK('MONTH',DOB,TODAY);
DAYS_DIFF=INTCK('DAY',DOB,TODAY);
QTR_DIFF=INTCK('QTR',DOB,TODAY);
RUN;
PROC PRINT;RUN;

/*ADD DAYS,MONTHS,YAERS TO A DATE VALUE */

DATA DATES3;
DATE1=TODAY();
ADD_5DAYS=INTNX('DAY',DATE1,5);
ADD_5_MONTHS=INTNX('MONTH',DATE1,5);
ADD_5_YEARS=INTNX('YEAR',DATE1,5);
ADD_5_MONTHS_SAME=INTNX('MONTH',DATE1,5,'S');
ADD_5_YEARS_SAME=INTNX('YEAR',DATE1,5,'S');
ADD_5_MONTHS_BEGIN=INTNX('MONTH',DATE1,5,'B');
ADD_5_YEARS_BEGIN=INTNX('YEAR',DATE1,5,'B');
ADD_5_MONTHS_END=INTNX('MONTH',DATE1,5,'E');
ADD_5_YEARS_END=INTNX('YEAR',DATE1,5,'E');
FORMAT DATE1 ADD_5_YEARS_SAME ADD_5_MONTHS_SAME ADD_5_YEARS_BEGIN 
ADD_5_MONTHS_BEGIN 
ADD_5DAYS ADD_5_MONTHS ADD_5_YEARS ADD_5_MONTHS_END 
ADD_5_YEARS_END DDMMYY10.;
RUN;
PROC PRINT;RUN;


























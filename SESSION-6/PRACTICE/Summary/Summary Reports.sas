PROC FREQ
PROC REPORT
PROC TABULATE
*/

/* WW_LAPTOP_SALES DATASET */
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN6.WW_LAPTOP_SALES
			DATAFILE='/home/u61735472/BATCH_202203/A6.SESSION-6/RAW DATA/A2.LAPTOP SALES DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='WW_SALES';
RUN;			
PROC PRINT DATA=SSN6.WW_LAPTOP_SALES;RUN;

/* KPI */
PROC SQL;
CREATE TABLE WW_LAPTOP_SALES_V1 AS
SELECT
COUNT(*) AS NO_OF_ORDERS FORMAT=COMMA15.,
MEAN(PRICE) AS AVG_PRICE FORMAT=DOLLAR8.3,
SUM(UNITS) AS TOT_UNITS FORMAT=COMMA15.,
SUM(SALES) AS TOT_SALES FORMAT=DOLLAR15.3
FROM SSN6.WW_LAPTOP_SALES 
;
QUIT;
PROC PRINT DATA=WW_LAPTOP_SALES_V1;RUN;


/* USING BASE SAS */
PROC MEANS DATA=SSN6.WW_LAPTOP_SALES ;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES ;
VAR UNITS PRICE SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM;
VAR UNITS PRICE SALES;
RUN;

/* LAPTOP WISE COUNT,MEAN,SUM ETC */

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM;
CLASS LAPTOP;
VAR UNITS PRICE SALES;
RUN;

/* PROC MEANS IN DETAILS */
PROC MEANS DATA=SSN6.WW_LAPTOP_SALES ;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES ;
CLASS LAPTOP;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES ;
CLASS LAPTOP COUNTRY;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES ;
CLASS LAPTOP PURCHASE_YEAR;
VAR SALES PRICE;
RUN;

/* COUNTRY LAPTOP PURCHASE_YEAR WISE TOT_UNIT,TOT_SALES, MEAN_SALE  */
PROC MEANS DATA=SSN6.WW_LAPTOP_SALES NWAY;
CLASS COUNTRY LAPTOP PURCHASE_YEAR ;
VAR UNITS SALES ;
OUTPUT OUT=REPORT1 (DROP=_TYPE_	_FREQ_) SUM(UNITS)=TOT_UNIT SUM(SALES)=TOT_SALES MEAN(SALES)=AVG_SALES;
FORMAT TOT_UNIT COMMA15. TOT_SALES AVG_SALES DOLLAR12.;
RUN;


/* PROC SUMMARY */
PROC SUMMARY DATA=SSN6.WW_LAPTOP_SALES NWAY PRINT;
CLASS COUNTRY LAPTOP PURCHASE_YEAR;
VAR UNITS SALES;
OUTPUT OUT=REPORT2 (DROP=_TYPE_ _FREQ_) SUM(UNITS)=TOT_UNITS SUM(SALES)=TOT_SALES MEAN(SALES)=AVG_SALES;
FORMAT TOT_UNITS FORMAT COMMA15. TOT_SALES AVG_SALES FORMAT DOLLAR15.  ;
RUN;


























PROC TABULATE DATA=SSN6.WW_LAPTOP_SALES;
CLASS LAPTOP COUNTRY;
CLASSLEV LAPTOP COUNTRY;
VAR SALES;
TABLE LAPTOP ALL='TOT_SALES' , COUNTRY*SALES*SUM ALL*SALES*SUM;
RUN;

PROC TABULATE DATA=SSN6.WW_LAPTOP_SALES;
CLASS COUNTRY LAPTOP PURCHASE_YEAR;
CLASSLEV COUNTRY LAPTOP PURCHASE_YEAR;
VAR SALES;
TABLES COUNTRY ALL=TOT_SALES, LAPTOP*PURCHASE_YEAR*SALES*SUM ALL*SALES*SUM;
RUN;










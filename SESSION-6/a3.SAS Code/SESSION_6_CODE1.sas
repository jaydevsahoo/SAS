OPTIONS VALIDVARNAME=V7;
PROC IMPORT OUT=SSN6.GLOBAL_SALES
            DATAFILE='/home/debendra330/BATCH_202204/A6.SESSION_6/A1.RAW_DATA/A1.SAS Functions By Example.xlsx'
            DBMS=XLSX REPLACE;
            SHEET='DATA';

PROC CONTENTS DATA=SSN6.GLOBAL_SALES VARNUM SHORT;
RUN;

/*
Row_ID 
Order_ID 
Order_Date 
Ship_Date 
Ship_Mode 
Customer_ID 
Customer_Name 
DOB 
Segment 
City 
State 
Country 
Postal_Code 
Market 
Region 
Product_ID 
Category 
Sub_Category 
Product_Name 
Sales 
Quantity 
Discount 
Profit 
Shipping_Cost 
Order_Priority
*/

PROC SQL;
CREATE TABLE SSN6.GLOBAL_SALES_V1
AS
SELECT
Row_ID, 
Order_ID ,
SUBSTR(Order_ID,1,2) AS COUNTRY_CODE,
SUBSTR(Order_ID,9,20) AS ORDER_NUMBER,
Order_Date ,
YEAR(Order_Date) AS ORDER_YEAR,
MONTH(Order_Date) AS ORDER_MONTH,
DAY(Order_Date) AS ORDER_DAY,
YEAR(Order_Date)*100+MONTH(Order_Date) AS ORDER_YEAR_MONTH,
CASE
	WHEN MONTH(Order_Date) IN (1,2,3) THEN 'Q1'
	WHEN MONTH(Order_Date) IN (4,5,6) THEN 'Q2'
	WHEN MONTH(Order_Date) IN (7,8,9) THEN 'Q3'
	ELSE 'Q4'
END AS QTR,
Ship_Date ,
INTCK('DAY',Order_Date,Ship_Date) AS DAYS_GAP_IN_DELIVERY,
Ship_Mode ,
Customer_ID ,
Customer_Name, 
SUBSTR(Customer_Name,1,FIND(Customer_Name,' ')-1) AS CUSTOMER_FNAME,
SUBSTR(Customer_Name,FIND(Customer_Name,' ')+1,30) AS CUSTOMER_LNAME,
DOB ,
INTCK('YEAR',DOB,TODAY()) AS AGE,
CASE
	WHEN CALCULATED AGE >= 60 THEN 'OLD-AGE'
	WHEN CALCULATED AGE >= 50 THEN 'MID-OLD-AGE'
	WHEN CALCULATED AGE >= 40 THEN 'MID-AGE'
	WHEN CALCULATED AGE >= 30 THEN 'MID-YOUNG-AGE'
	ELSE 'YOUNG-AGE'
END AS AGE_BUCKET,
Segment ,
City ,
State ,
Country ,
Postal_Code ,
CASE
	WHEN Postal_Code=. THEN 99999999
	ELSE Postal_Code
END AS NEW_POSTAL_CODE,
Market ,
Region ,
Product_ID ,
Category ,
Sub_Category ,
Product_Name ,
Sales ,
Quantity ,
Discount FORMAT=PERCENT10. ,
(Sales*Discount) AS DISCOUNTED_AMOUNT FORMAT=DOLLAR15.,
(Sales- CALCULATED DISCOUNTED_AMOUNT) AS SALES_AFTER_DISCOUNT_AMOUNT FORMAT=DOLLAR15.,
Profit FORMAT=DOLLAR15.,
Shipping_Cost FORMAT=DOLLAR15. ,
Order_Priority
FROM SSN6.GLOBAL_SALES;
QUIT;

















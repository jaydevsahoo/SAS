/* LETS USE WW_PLAPTOP_SALES DATASET */

OPTIONS VALIDVARNAME=V7;

PROC IMPORT OUT=SSN6.WW_LAPTOP_SALES
            DATAFILE='/home/debendra330/BATCH_202204/A6.SESSION_6/A1.RAW_DATA/A2.LAPTOP SALES DATA.xlsx'
            DBMS=XLSX REPLACE;
            SHEET='WW_SALES';
RUN;

/* STEP-1 TO SUMMARIZE DATA */

PROC SQL;
SELECT 
COUNT(LAPTOP) AS NO_OF_ORDERS FORMAT=COMMA15.,
SUM(UNITS) AS TOTAL_UNITS_SOLD FORMAT=COMMA15.,
MEAN(PRICE) AS AVG_PRICE FORMAT=DOLLAR15.,
SUM(SALES) AS TOTAL_SALES FORMAT=DOLLAR15.
FROM SSN6.WW_LAPTOP_SALES;
QUIT;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM;
VAR UNITS PRICE SALES;
RUN;



PROC SQL;
SELECT 
LAPTOP,
COUNT(LAPTOP) AS NO_OF_ORDERS FORMAT=COMMA15.,
SUM(UNITS) AS TOTAL_UNITS_SOLD FORMAT=COMMA15.,
MEAN(PRICE) AS AVG_PRICE FORMAT=DOLLAR15.,
SUM(SALES) AS TOTAL_SALES FORMAT=DOLLAR15.
FROM SSN6.WW_LAPTOP_SALES
GROUP BY LAPTOP
ORDER BY 1;
QUIT;


PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM;
CLASS LAPTOP;
VAR UNITS PRICE SALES;
RUN;

/* LETS DO PROC MEANS IN DETAILS */

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM MIN MAX;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM MIN MAX;
CLASS LAPTOP;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM MIN MAX STD;
CLASS LAPTOP COUNTRY;
VAR SALES;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N MEAN SUM MIN MAX STD;
CLASS LAPTOP COUNTRY PURCHASE_YEAR;
VAR SALES;
RUN;

/* SQL VS PROC MEANS  */

PROC SQL;
SELECT
COUNTRY,
LAPTOP,
PURCHASE_YEAR,
SUM(UNITS) AS TOTAL_UNITS_SOLD FORMAT=COMMA15.,
SUM(SALES) AS TOTAL_SALES FORMAT=DOLLAR15.,
MEAN(SALES) AS AVG_SALES FORMAT=DOLLAR15.
FROM SSN6.WW_LAPTOP_SALES
GROUP BY 1,2,3
ORDER BY 1,2,3;
QUIT;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES;
CLASS COUNTRY LAPTOP PURCHASE_YEAR;
VAR UNITS SALES;
OUTPUT OUT=WW_SALES_SUMMARY_1 SUM(UNITS)=TOTAL_UNITS_SOLD SUM(SALES)=TOTAL_SALES MEAN(SALES)=AVG_SALES;
RUN;

PROC EXPORT DATA=WW_SALES_SUMMARY_1
            OUTFILE='/home/debendra330/BATCH_202204/A6.SESSION_6/A4.SAS_OUTPUT/WW_SALES_SUMMARY_1.CSV'
            DBMS=CSV REPLACE;
RUN;


PROC MEANS DATA=SSN6.WW_LAPTOP_SALES NWAY;
CLASS COUNTRY LAPTOP PURCHASE_YEAR;
VAR UNITS SALES;
OUTPUT OUT=WW_SALES_SUMMARY_1 (DROP=_FREQ_ _TYPE_) SUM(UNITS)=TOTAL_UNITS_SOLD SUM(SALES)=TOTAL_SALES MEAN(SALES)=AVG_SALES;
FORMAT UNITS COMMA15. SALES DOLLAR15.;
RUN;

/* NWAYS IS AN OPTION, WE USE TO AVOID CREATING OVERALL SUMMARY IN THE DATASET */

/* WE CAN ALSO ACHIEVE THE SAME THING USING PROC SUMMARY */

PROC SUMMARY DATA=SSN6.WW_LAPTOP_SALES NWAY PRINT;
CLASS COUNTRY LAPTOP PURCHASE_YEAR;
VAR UNITS SALES;
OUTPUT OUT=WW_SALES_SUMMARY_1 (DROP=_FREQ_ _TYPE_) SUM(UNITS)=TOTAL_UNITS_SOLD SUM(SALES)=TOTAL_SALES MEAN(SALES)=AVG_SALES;
FORMAT UNITS COMMA15. SALES DOLLAR15.;
RUN;

/* PROC MEANS VS PROC SUMMARY */
/* ANS- PROC MEANS AND PROC SUMMARY WILL PROVIDE THE SUMMARY OUTPUT. HOWEVER, PROC SUMMARY WE HAVE TO USE PRINT AS AN OPTION TO PRINT THE OUTPUT */

/* HOW TO GET MISSING VALUES IN A DATASET */
/* ====================================== */

DATA ALL;
INFILE CARDS DSD DLM=',';
INPUT PROD $ JAN FEB MAR;
CARDS;
APPLE,90,,80
DELL,80,90,
ACER,,,90
;
RUN;

PROC PRINT DATA=ALL;
RUN;

PROC MEANS DATA=ALL N NMISS;
VAR JAN FEB MAR;
RUN;

PROC MEANS DATA=SSN6.WW_LAPTOP_SALES N NMISS;
VAR SALES;
RUN;

/* USE OF PROC UNIVARIATE */
/* ================================ */

/* WE USE PROC MEANS TO GET */
/* 1. N */
/* 2. MEAN */
/* 3. STD */
/* 4. MIN */
/* 5. MAX */
/* 6. SUM */

/* USING PROC UNIVARIATE */

PROC UNIVARIATE DATA=SSN6.WW_LAPTOP_SALES;
RUN;


PROC UNIVARIATE DATA=SSN6.WW_LAPTOP_SALES;
VAR SALES;
RUN;

PROC UNIVARIATE DATA=SSN6.WW_LAPTOP_SALES;
CLASS LAPTOP;
VAR SALES;
RUN;

/* IN PROC UNIVARIATE WHAT ARE THE STATISTICAL OUTPUT WE SEE */

/* 1. MEAN */
/* 2. MEDIAN */
/* 3. STD */
/* 4. VARIANCE */
/* 5. COEFF VAR */
/* 6. MEAN ERROR */
/* 7. SKEWNESS */
/* 8. KURTOSYS */
/* 9. TANGE */
/* 10. RANGE WITH VALUES DENOTED OBS */

/* PROC FREQ */
/* ================== */

PROC FREQ DATA=SSN6.WW_LAPTOP_SALES;
RUN;

/* ONE-WAY FREQ */
PROC FREQ DATA=SSN6.WW_LAPTOP_SALES;
TABLES LAPTOP;
RUN;

/* TWO-WAY FREQ */
PROC FREQ DATA=SSN6.WW_LAPTOP_SALES;
TABLES LAPTOP*COUNTRY;
RUN;

/* CAN WE SAVE THIS PROC FREQ OUTPUT */

PROC FREQ DATA=SSN6.WW_LAPTOP_SALES;
TABLES LAPTOP*COUNTRY / OUT=FREQ_REPORT1 NOCUM NOPERCENT;
RUN;

/* PROC REPORT  */
/* ====================== */

PROC REPORT DATA=SSN6.WW_LAPTOP_SALES HEADLINE HEADSKIP;
COLUMN COUNTRY LAPTOP PURCHASE_YEAR UNITS SALES;
DEFINE COUNTRY / WIDTH=15 GROUP;
DEFINE LAPTOP / WIDTH=10 GROUP;
DEFINE PURCHASE_YEAR / WIDTH=10 GROUP;
DEFINE UNITS / WIDTH=10 'TOTAL UNITS SOLD';
DEFINE SALES / WIDTH=10 'TOTAL SALES';
RBREAK AFTER/SUMMARIZE DOL DUL;
FORMAT UNITS COMMA15. SALES DOLLAR15.;
RUN;

ODS PDF FILE='/home/debendra330/BATCH_202204/A6.SESSION_6/A4.SAS_OUTPUT/SALES_REPORT_2022.PDF';
PROC REPORT DATA=SSN6.WW_LAPTOP_SALES HEADLINE HEADSKIP;
COLUMN COUNTRY LAPTOP PURCHASE_YEAR UNITS SALES;
DEFINE COUNTRY / WIDTH=15 GROUP;
DEFINE LAPTOP / WIDTH=10 GROUP;
DEFINE PURCHASE_YEAR / WIDTH=10 GROUP;
DEFINE UNITS / WIDTH=10 'TOTAL UNITS SOLD';
DEFINE SALES / WIDTH=10 'TOTAL SALES';
RBREAK AFTER/SUMMARIZE DOL DUL;
FORMAT UNITS COMMA15. SALES DOLLAR15.;
TITLE 'SALES REPORT 2022';
FOOTNOTE 'SALES REPORT WAS PREPARED BY DV ANALYTICS';
RUN;
ODS PDF CLOSE;

ODS HTML FILE='/home/debendra330/BATCH_202204/A6.SESSION_6/A4.SAS_OUTPUT/SALES_REPORT_2022.HTML';
PROC REPORT DATA=SSN6.WW_LAPTOP_SALES HEADLINE HEADSKIP;
COLUMN COUNTRY LAPTOP PURCHASE_YEAR UNITS SALES;
DEFINE COUNTRY / WIDTH=15 GROUP;
DEFINE LAPTOP / WIDTH=10 GROUP;
DEFINE PURCHASE_YEAR / WIDTH=10 GROUP;
DEFINE UNITS / WIDTH=10 'TOTAL UNITS SOLD';
DEFINE SALES / WIDTH=10 'TOTAL SALES';
RBREAK AFTER/SUMMARIZE DOL DUL;
FORMAT UNITS COMMA15. SALES DOLLAR15.;
TITLE 'SALES REPORT 2022';
FOOTNOTE 'SALES REPORT WAS PREPARED BY DV ANALYTICS';
RUN;
ODS HTML CLOSE;


/* PROC TABULATE */
/* ======================= */

PROC TABULATE DATA=SSN6.WW_LAPTOP_SALES;
TABLE LAPTOP;
CLASS LAPTOP;
RUN;

PROC TABULATE DATA=SSN6.WW_LAPTOP_SALES FORMAT=DOLLAR17.;
CLASS LAPTOP COUNTRY;
CLASSLEV LAPTOP COUNTRY;
VAR SALES;
TABLE LAPTOP ALL='TOTAL_SALES' , COUNTRY*SALES*SUM ALL*SALES*SUM;
RUN;

ODS PDF FILE='/home/debendra330/BATCH_202204/A6.SESSION_6/A4.SAS_OUTPUT/WW_SALES_REPORT.PDF';
PROC TABULATE DATA=SSN6.WW_LAPTOP_SALES FORMAT=DOLLAR17. S=[FOREGROUND=BLACK JUST=C];
CLASS LAPTOP COUNTRY;
CLASSLEV LAPTOP COUNTRY / S=[BACKGROUND=BLUE FOREGROUND=WHITE];
VAR SALES;
TABLE LAPTOP ALL='TOTAL_SALES' , COUNTRY*SALES*MEAN ALL*SALES*MEAN={S=[FOREGROUND=WHITE BACKGROUND=PURPLE]} ;
RUN;
ODS PDF CLOSE;

/* SAS CHARTS */
/* ================== */

PROC PRINT DATA=SSN6.WW_LAPTOP_SALES (OBS=10);
RUN;

/* HORIZONTAL BAR CHART */
TITLE1 "SALES BY LAPTOP";
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
HBAR LAPTOP / TYPE=SUM SUMVAR=SALES;
RUN;

/* VERTICAL BAR CHART */
TITLE1 "SALES BY COUNTRY";
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR COUNTRY / TYPE=SUM SUMVAR=SALES;
RUN;

/* VERICAL BAR CHART WITH DATA LABEL */
TITLE1 "SALES BY COUNTRY";
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR COUNTRY / TYPE=SUM SUMVAR=SALES OUTSIDE=SUM;
RUN;

/* VERICAL BAR CHART WITH DATA LABEL IN DESCENDING ORDER*/
TITLE1 "SALES BY COUNTRY";
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR COUNTRY / TYPE=SUM SUMVAR=SALES DESCENDING OUTSIDE=SUM;
RUN;

/* VBAR WITH AXIS NAME */
TITLE1 "SALES BY COUNTRY";
GOPTIONS HTEXT=13PT HTITLE=15PT;
AXIS1 LABEL=NONE;
AXIS2 LABEL=('SALES IN DOLLAR');
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR COUNTRY / TYPE=SUM SUMVAR=SALES DESCENDING
MAXIS=AXIS1 RAXIS=AXIS2;
RUN;
QUIT;

/* VBAE WITH COLOUR GRIDIING */
PATTERN1 V=SOLID COLOR=RED;
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR COUNTRY / WIDTH= 25 TYPE=MEAN SUMVAR=SALES DESCENDING
MAXIS=AXIS1 RAXIS=AXIS2 OUTSIDE=MEAN COUTLINE=GRAY;
RUN;
QUIT;

/* VBAR WITH MULTIP COLOURS */
TITLE1 "AVERAGE LAPTOP SALES";
PATTERN1 VALUE=SOLID COLOR=PINK;
PATTERN2 VALUE=SOLID COLOR=CX42C0FB;
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR LAPTOP / WIDTH= 25 TYPE=MEAN SUMVAR=SALES DESCENDING
MAXIS=AXIS1 RAXIS=AXIS2 OUTSIDE=MEAN COUTLINE=GRAY SUBGROUP=LAPTOP;
RUN;
QUIT;


/* VBAR WITH FREQ IN PERCENTAGE */
TITLE1 "% OF LAPTOP SALES";
GOPTIONS HTEXT=13PT HTITLE=15PT;
AXIS1 LABEL=NONE  VALUE=(F="ARIAL/BOLD" "LAPTOP"); ;
AXIS2 LABEL=(A=90 F="ARIAL/BOLD" 'PERCENTAGE OF LAPTOP SALES') MINOR=NONE  OFFSET=(0,0);
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR LAPTOP / WIDTH= 25 TYPE=PCT DESCENDING
MAXIS=AXIS1 RAXIS=AXIS2 INSIDE= FREQ OUTSIDE=PCT;
RUN;
QUIT;


/* VBAR WITH MULTI-BARS */
TITLE;
AXIS1 LABEL=('MSRP') MINOR=NONE OFFSET=(0,0);
AXIS2 LABEL=NONE;
AXIS3 LABEL=NONE OFFSET=(7,7);
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;
VBAR LAPTOP  / DISCRETE TYPE=MEAN SUMVAR=SALES
GROUP=COUNTRY COUTLINE=GRAY RAXIS=AXIS1 MAXIS=AXIS2 GAXIS=AXIS3 NOFRAME;
RUN;
QUIT;

/* STACKED BAT CHARTS */
TITLE;
AXIS1 LABEL=('MSRP') MINOR=NONE OFFSET=(0,0);
AXIS2 LABEL=NONE OFFSET=(7,7);
PROC GCHART DATA=SSN6.WW_LAPTOP_SALES;

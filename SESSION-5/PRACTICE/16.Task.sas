OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=AC_DETAILS
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/Transaction data.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='AC_DETAILS';
RUN;			
PROC IMPORT OUT=TRANS_DETAILS
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/Transaction data.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='Sheet1';
RUN;

PROC SORT DATA=AC_DETAILS OUT=AC_DETAILS_V1;
BY ACC_NO DESCENDING MONTH;
RUN;

DATA X;
SET AC_DETAILS_V1;
WHERE MONTH IN (202201,202202,202203);
RUN;


OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=AC_DETAILS_DATE
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/Transaction data.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='AC_DETAILS_DATE';
RUN;			
PROC IMPORT OUT=TRAN_DETAILS_DATE
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/Transaction data.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='TRAN_DETAILS_DATE';
RUN;

DATA X;

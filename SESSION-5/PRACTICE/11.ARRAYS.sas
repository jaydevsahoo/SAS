/* CHAR AND NUMERIC VALUES ARE MISSING 
NUMERIC MISSING=0
CHAR MISSING=0
*/

DATA MED_2022_V1;
SET MED_2022;
ARRAY CHARS _CHARACTER_;
ARRAY NUMS _NUMERIC_;
DO OVER CHARS;
	IF CHARS=' ' THEN CHARS='N/A';
END;
DO OVER NUMS;
	IF NUMS=' ' THEN NUMS=0;
END;
RUN;
PROC PRINT DATA=MED_2022_V1;RUN;
/*
ARRAY IS A STATEMENT
CHARS,NUMS->ARRAY NAME
_CHARACTER_,_NUMERIC_ ->ELEMENTS
*/


/* EX2 */
DATA PROD_SALES;
INFILE CARDS DSD DLM='09'X;
INPUT PRODUCT  $ MONTH1 MONTH2 MONTH3 MONTH4 MONTH5 MONTH6;
CARDS;
APPLE	300	301	200	256	489	987
HP	278	486	520	753	655	783
DELL	892	632	532	448	850	655
LENOVO	753	952	935	263	783	654
ACER	705	100	36	625	750	45
;
RUN;
PROC PRINT DATA=PROD_SALES;RUN;


/* ADD 100 TO EACH MONTH SALES */
DATA PROD_SALE1;
SET PROD_SALES;
ARRAY SALES {6} MONTH1-MONTH6;
DO I=1 TO 6;
 	SALES(I)=SALES(I)+100;	
END;	
DROP I;
RUN;
PROC PRINT ;RUN;



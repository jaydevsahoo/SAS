LIBNAME SSN5 '/home/u61735472/BATCH_202203/A5.SESSION-5/DATASET';RUN;

DATA MED_SELECT(KEEP=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE SPENT_AMOUNT);
SET SSN5.MED_2022;
RUN;

/* CREATE SL NO */
DATA MED_SELECT_V1;
SET MED_SELECT;
ORDER_NO=_N_;
RUN;

/* SELECT EVERY ALTERNATIVE DATA */
DATA MED_SELECT_V2;
SET MED_SELECT_V1;
IF MOD(ORDER_NO,5)=0;
RUN;

DATA MED_SELECT_V3;
SET MED_SELECT_V1;
IF MOD(ORDER_NO,2)=0;
RUN;

DATA MED_SELECT_V4;
SET MED_SELECT_V1;
IF MOD(ORDER_NO,2)<>0;
RUN;


/* SELECT RANDOM DATASET */
PROC SURVEYSELECT DATA=MED_SELECT METHOD=SRS N=100 OUT=SAMPLE;
RUN;


















































































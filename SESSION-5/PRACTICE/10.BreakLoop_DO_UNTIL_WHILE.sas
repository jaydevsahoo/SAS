/*Breaking loop using
  DO UNTIL AND DO WHILE*/
 
/* DO UNTIL */
DATA INVEST;
CAPITAL=0;
DO YEAR=1 TO 20 UNTIL(CAPITAL>=20000000);
CAPITAL+500000;
CAPITAL+CAPITAL*0.06;
OUTPUT;
END;
RUN;
PROC PRINT DATA=INVEST;
RUN;

DATA INVEST;
CAPITAL=0;
DO YEAR=1 TO 30 UNTIL(CAPITAL>=20000000);
CAPITAL+500000;
CAPITAL+CAPITAL*0.06;
OUTPUT;
END;
RUN;
PROC PRINT DATA=INVEST;
RUN;


/* DO WHILE */

DATA INVEST;
YEAR=0;
CAPITAL=0;
DO WHILE(CAPITAL<=20000000);
YEAR+1;
CAPITAL+500000;
CAPITAL+CAPITAL*0.06;
OUTPUT;
END;
RUN;
PROC PRINT DATA=INVEST;
RUN;


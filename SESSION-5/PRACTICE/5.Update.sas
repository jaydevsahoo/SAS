/* ===================================================== */

/* UPDATE */
/* FIND OUT LATEST SALES */
DATA PROD_PRICE_202001;
INFILE CARDS DSD DLM=',' MISSOVER;
INPUT PRODUCT $ PRICE MONTH $;
CARDS;
APPLE,89000,202001
DELL,67000,202001
ACER,76000,202001
ASUS,80000,202001
LENOVO,65000,202001
SAMSUNG,89000,202001
;
RUN;

DATA PROD_PRICE_202002;
INFILE CARDS DSD DLM=',' MISSOVER;
INPUT PRODUCT $ PRICE MONTH $;
CARDS;
APPLE,89000,202002
DELL,80000,202002
ACER,76000,202002
ASUS,70000,202002
TOSHIBA,54000,202002
HCL,34000,202002
;
RUN;

PROC PRINT DATA=PROD_PRICE_202001;
RUN;

PROC PRINT DATA=PROD_PRICE_202002;
RUN;

/* JOIN THEM */
PROC SORT DATA=PROD_PRICE_202001;
BY PRODUCT;
RUN;
PROC SORT DATA=PROD_PRICE_202002;
BY PRODUCT;
RUN;

DATA PROD_PRICE_NEW;
UPDATE PROD_PRICE_202001 PROD_PRICE_202002;
BY PRODUCT;
RUN;
PROC PRINT DATA=PROD_PRICE_NEW;

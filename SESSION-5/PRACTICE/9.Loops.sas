/* 500000 INVESTMENT AT 10% IN BANK EACH YEAR FOR NEXT 20 YEARS */

DATA AMOUNT;
CAPITAL=0;
DO YEAR=1 TO 20;
	CAPITAL+500000;
	CAPITAL+CAPITAL*0.1;
OUTPUT;
END;
RUN;
PROC PRINT DATA=AMOUNT;
RUN;


/* Q. PRINCIPAL=100, RATE=10%, TIME=3 YEARS IN COMPOUND INTEREST 
AMOUNT AT THE END OF 3 YEARS ?*/

DATA AMOUNT;
CAPITAL=100;
RATE=0.1;
DO YEAR=1 TO 3;
	CAPITAL+CAPITAL*RATE;
OUTPUT;	
END;
RUN;
PROC PRINT DATA=AMOUNT;
RUN;


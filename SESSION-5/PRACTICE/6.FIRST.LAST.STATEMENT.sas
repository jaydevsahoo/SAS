/* USE FIRST. LAST. TO REMOVE DUPLICATES */
PROC IMPORT OUT=STU_SCORE
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/DUPLICATE_DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='DATA';
RUN;			
PROC SORT DATA=STU_SCORE OUT=STU_SCORE2;
BY NAME SUBJECT SCORE; RUN;
/* METHOD-1 */
PROC SQL;
SELECT NAME,SUBJECT,SCORE FROM STU_SCORE 
GROUP BY NAME,SUBJECT,SCORE
HAVING COUNT(*)>1;
QUIT;
/* METHOD-2 */
DATA STU_SCORE3;
SET STU_SCORE2;
RUN;

PROC SORT DATA=STU_SCORE3 NODUP DUPOUT=X;
BY NAME;
RUN;

/* METHOD-3 */
DATA A B;
SET STU_SCORE2;
BY NAME SUBJECT SCORE;
IF FIRST.SCORE THEN OUTPUT A;
ELSE IF LAST.SCORE THEN OUTPUT B;
RUN;

/*
IN HOW MANY WAYS WE CAN REMOVE DUPLICATES FROM SAS?
ANS-3 WAYS
1. PROC SQL
2. DUPKEY
3. FIRST. LAST.
*/





















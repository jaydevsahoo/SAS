/* EX */
/* STARTING DATE OF SALES AND ENDING DATE OF SALES OF PRINTER? */
PROC IMPORT OUT=PRINTER_SALES
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/PRINTER SALES.xlsx'
			DBMS=XLSX REPLACE;
			RANGE='PRINTER_SALES';
RUN;
PROC SORT DATA=	PRINTER_SALES;
BY 	COUNTRY PRINTER SALES_DATE;
RUN;	

DATA PRINTER_SALES_V1;
SET PRINTER_SALES;
BY COUNTRY PRINTER;
IF FIRST.PRINTER THEN SELECT1=1;
ELSE IF LAST.PRINTER THEN SELECT2=1;
IF SELECT1=1 OR SELECT2=1;
RUN;
PROC PRINT DATA=PRINTER_SALES_V1;RUN;
/* OR */
PROC SQL;
SELECT COUNTRY,PRINTER,
MIN(SALES_DATE) AS FIRST_SALE FORMAT=DDMMYY10.,
MAX(SALES_DATE) AS LAST_SALE FORMAT=DDMMYY10.
FROM PRINTER_SALES
GROUP BY 1,2
ORDER BY 1,2;
QUIT;


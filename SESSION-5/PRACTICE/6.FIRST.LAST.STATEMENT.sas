DATA STU_SUB_SCORE;
INPUT STU_NAME $ APPLICATION $ SCORE;
CARDS;
TONY EXCEL 89
TONY SQL 90
TONY SAS 69
TONY PYTHON 50
STARK EXCEL 80
STARK SQL 78
STARK SAS 90
STARK PYTHON 34
STEVE EXCEL 56
STEVE SQL 90
STEVE SAS 59
STEVE PYTHON 90
;
RUN;

PROC PRINT DATA=STU_SUB_SCORE;
RUN;

PROC SORT DATA=STU_SUB_SCORE;
BY STU_NAME;
RUN;

/* EX */
/* Show first record of each student? */
DATA STU_SUB_SCORE_V1;
SET STU_SUB_SCORE;
BY STU_NAME;
IF FIRST.STU_NAME;
PROC PRINT;
RUN;

/*
Q. Can we use WHERE instead of IF with First. and Last. Variables?
No. WHERE statement cannot be used with First. and Last. Variables. 
It is because WHERE statement requires variables already be created in the dataset 
before processing.
*/

/* EX-1 */
DATA STU_SUB_SCORE2;
SET STU_SUB_SCORE;
BY STU_NAME;
IF FIRST.STU_NAME THEN SELECT=1;
ELSE SELECT=0;
IF LAST.STU_NAME THEN SELECT2=1;
ELSE SELECT2=0;
RUN;
PROC PRINT DATA=STU_SUB_SCORE2;RUN;

/* EX-2 */
DATA STU_SUB_SCORE3;
SET STU_SUB_SCORE;
BY STU_NAME;
IF FIRST.STU_NAME THEN DO;
	TOT_SCORE=0;
END;
TOT_SCORE+SCORE;
RUN;
PROC PRINT DATA=STU_SUB_SCORE3;RUN;

/* EX-3 */
DATA STU_SUB_SCORE4;
SET STU_SUB_SCORE;
BY STU_NAME;
IF FIRST.STU_NAME THEN DO;
	TOT_SCORE=0;
END;
TOT_SCORE+SCORE;
IF LAST.STU_NAME;
DROP APPLICATION	SCORE;
RUN;
PROC PRINT DATA=STU_SUB_SCORE4;RUN;


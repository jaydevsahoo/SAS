/* HOW TO RANK VALUES USING FIRST. & LAST. OR PROC RANK PROCEDURE  */

PROC IMPORT OUT=STU_SCORE
			DATAFILE='/home/u61735472/Practice/RAW DATA/DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='DATA';
RUN;			
PROC SORT DATA=STU_SCORE OUT=STU_SCORE_V1;
BY NAME	DESCENDING SCORE;
RUN;
/* RANKING */
/* 1ST WAY */
DATA STU_SCORE_V2;
SET STU_SCORE_V1;
BY NAME;
IF FIRST.NAME THEN RANK=1;
ELSE RANK+1;
IF RANK IN(2,3);/*FIND 2ND AND 3RD RANK*/
RUN;
PROC PRINT DATA=STU_SCORE_V2;RUN;

/* 2ND WAY */
DATA STU_SCORE_V3;
SET STU_SCORE;
RUN;

PROC SORT DATA=STU_SCORE OUT=STU_SCORE_V4;
BY NAME DESCENDING SCORE;
RUN;

PROC RANK DATA=STU_SCORE_V4 DESCENDING OUT=STU_SCORE_RANK;
VAR SCORE;
RANKS RANKING;
BY NAME;
RUN;
PROC PRINT DATA=STU_SCORE_RANK;RUN;


/* PROC RANK EX-2 */
LIBNAME SSN5 '/home/u61735472/BATCH_202203/A5.SESSION-5/DATASET';RUN;
PROC IMPORT OUT=SSN5.PRINTER_SALES
			DATAFILE='/home/u61735472/BATCH_202203/A5.SESSION-5/RAW DATA/PRINTER SALES.xlsx'
			DBMS=XLSX REPLACE;
			RANGE='PRINTER_SALES';
RUN;


/* RANK SALES IN PRINTER SALES DATA */
PROC SORT DATA=SSN5.PRINTER_SALES OUT=PRINTER_SALES_V1;
BY COUNTRY DESCENDING UNITS;
RUN;

PROC RANK DATA=PRINTER_SALES_V1 DESCENDING OUT=PRINTER_SALES_V2;
VAR UNITS;
RANKS RANKINGS;
BY COUNTRY;
RUN;
PROC PRINT DATA=PRINTER_SALES_V2;RUN;


/* COUNTRY WISE NO OF UNIT SOLD BY RANK */
	/* CREATE COMBINE DATA */
PROC SQL;
CREATE TABLE PRINTER_SALES_V3 AS 
SELECT COUNTRY,PRINTER,
SUM(UNITS) AS TOT_SALES
FROM SSN5.PRINTER_SALES
GROUP BY COUNTRY,PRINTER
ORDER BY 1,2
;
QUIT;
PROC PRINT DATA=PRINTER_SALES_V3;RUN;
	/* SORT THE DATA */
PROC SORT DATA=PRINTER_SALES_V3 OUT=PRINTER_SALES_V4;
BY COUNTRY DESCENDING TOT_SALES;
RUN;
   /* CREATE RANK*/
PROC RANK DATA=PRINTER_SALES_V4 DESCENDING OUT=PRINTER_SALES_V5;
VAR TOT_SALES;
RANKS RANKING;
BY COUNTRY;
RUN;
PROC PRINT DATA=PRINTER_SALES_V5;RUN;
	/*SELECT RANKS */
DATA PRINTER_SALES_V6;
SET PRINTER_SALES_V5;
WHERE RANKING IN (6,8,10);
RUN;
PROC PRINT DATA=PRINTER_SALES_V6;RUN;


































PROC PRINT DATA=PROD_CITY_SALES;
RUN;

/* IF PRODUCT='APPLE' AND CITY='BANGALORE' THEN DISCOUNT OF .30 ON PRICE */
/* IF PRODUCT='APPLE' AND CITY='MUMBAI' THEN DISCOUNT OF .40 ON PRICE */
/* IF PRODUCT='DELL' AND CITY='CHENNAI' THEN DISCOUNT OF .10 ON PRICE */
/* IF PRODUCT='DELL' AND CITY='DELHI' THEN DISCOUNT OF .30 ON PRICE */
/* IF PRODUCT='HP' AND CITY='BHUBANESWAR' THEN DISCOUNT OF .20 ON PRICE */
/* IF PRODUCT='HP' AND CITY='BANGALORE' THEN DISCOUNT OF .50 ON PRICE */

/* NESTED IF CONDITIONS IN SAS PROGRAMMING */

DATA PROD_CITY_SALES_V1;
SET PROD_CITY_SALES;
IF PRODUCT='APPLE' THEN DO;
   IF CITY='BANGALORE' THEN DISCOUNT=.30*PRICE;
   ELSE IF CITY='MUMBAI' THEN DISCOUNT=.40*PRICE;
   ELSE DISCOUNT=0;
END;
ELSE IF PRODUCT='DELL' THEN DO;
   IF CITY='CHENNAI' THEN DISCOUNT=.10*PRICE;
   ELSE IF CITY='DELHI' THEN DISCOUNT=.30*PRICE;
   ELSE DISCOUNT=0;
END;
ELSE IF PRODUCT='HP' THEN DO;
   IF CITY='BHUBANESWAR' THEN DISCOUNT=.20*PRICE;
   ELSE IF CITY='BANGALORE' THEN DISCOUNT=.50*PRICE;
   ELSE DISCOUNT=0;
END;
NEW_SELLING_PRICE=PRICE-DISCOUNT;
RUN;


/* IF THEN LOGIC IN SAS  */

DATA MED_2022;
SET SSN2.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE NO_OF_TRIPS SPENT_AMOUNT;
RUN;

/* LETS CREATE CONDITIONAL VARIABLES */

/* AGE_BUCKET */
/* ========================== */
/* AGE >= 60 THEN 'OLD-AGE' */
/* AGE >= 50 THEN 'MID-OLD-AGE' */
/* AGE >= 40 THEN 'MID-AGE' */
/* AGE >= 30 THEN 'MID-YOUNG-AGE' */
/* AGE < 30 THEN 'YOUNG-AGE' */

/* VISIT_BUCKET */
/* ========================== */
/* NO_OF_TRIPS >= 30 THEN 'REGULAR' */
/* NO_OF_TRIPS >= 10 THEN 'POWER' */
/* NO_OF_TRIPS < 10 THEN 'CASUAL' */

/* SPENT_BUCKET */
/* ========================== */
/* SPENT_AMOUNT >= 1000 THEN 'PREMIER' */
/* SPENT_AMOUNT >= 500 THEN 'ADVANCE' */
/* SPENT_AMOUNT < 500 THEN 'RETAIL' */

DATA MED_2022;
SET SSN2.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE NO_OF_TRIPS SPENT_AMOUNT AGE_BUCKET VISIT_BUCKET SPENT_BUCKET;
LENGTH AGE_BUCKET VISIT_BUCKET SPENT_BUCKET $30.;

/* AGE_BUCKET */
IF AGE >= 60 THEN AGE_BUCKET='OLD-AGE';
ELSE IF AGE >= 50 THEN AGE_BUCKET='MID-OLD-AGE';
ELSE IF AGE >= 40 THEN AGE_BUCKET='MID-AGE';
ELSE IF AGE >= 30 THEN AGE_BUCKET='MID-YOUNG-AGE';
ELSE AGE_BUCKET='YOUNG-AGE';

/* VISIT_BUCKET */
IF NO_OF_TRIPS >= 30 THEN VISIT_BUCKET='REGULAR';
ELSE IF NO_OF_TRIPS >= 10 THEN VISIT_BUCKET='POWER';
ELSE VISIT_BUCKET='CASUAL';

/* SPENT_BUCKET */
IF SPENT_AMOUNT >= 1000 THEN SPENT_BUCKET='PREMIER';
ELSE IF SPENT_AMOUNT >= 500 THEN SPENT_BUCKET='ADVANCE';
ELSE SPENT_BUCKET='RETAIL';
RUN;

/* IF THEN LOGIC BY EXAMPLE */
/* IN THE STAFF DATASET, WE WILL CREATE A BONUS VARIABLE */
/* IF JOBTITLE='MECHANIC' AND SALARY >= 50000 THEN BONUS=.20*SALARY */
/* IF JOBTITLE='MECHANIC' AND SALARY < 50000 THEN BONUS=.40*SALARY */
/* IF JOBTITLE='PILOT' AND SALARY >= 90000 THEN BONUS=.20*SALARY */
/* IF JOBTITLE='PILOT' AND SALARY < 90000 THEN BONUS=.40*SALARY */

DATA STAFF_BONUS;
SET SSN2.STAFF;
IF JOBTITLE='Mechanic' AND SALARY >= 50000 THEN BONUS=.20*SALARY;
ELSE IF JOBTITLE='Mechanic' AND SALARY < 50000 THEN BONUS=.40*SALARY;
ELSE IF JOBTITLE='Pilot' AND SALARY >= 90000 THEN BONUS=.20*SALARY;
ELSE BONUS=.40*SALARY;
NEW_SALARY=SALARY+BONUS;
FORMAT SALARY NEW_SALARY BONUS DOLLAR15.;
RUN;

/* IF THEN DO STATEMENT */

DATA MOBILE_USAGE;
INPUT MOBILE PLAN $ LOCAL_MOU STD_MOU ISD_MOU;
CARDS;
8951108662 PPS60 800 1000 100
8951108663 PPM30 1000 400 50
8951108664 PPS30 2000 1000 20
;
RUN;

PROC PRINT DATA=MOBILE_USAGE;
RUN;

/* PLAN AND BENEFITS */
/* PPS60 - LOCAL AND STD 1P/1SEC (60P/1M), RS3/1 MINUTE ISD CALLS */
/* PPM30 - LOCAL AND STD (30P/1M), RS4/1 MINUTE ISD CALLS */
/* PPS60 - LOCAL AND STD .5P/1SEC (30P/1M), RS5/1 MINUTE ISD CALLS */

/* CALCULATE THE USAGE REVENUE FOR LOCAL,STDAND ISD CALLS */

DATA MOBILE_USAGE_REV;
SET MOBILE_USAGE;
IF PLAN='PPS60' THEN DO;
LOCAL_REV=LOCAL_MOU*.60;
STD_REV=STD_MOU*.60;
ISD_REV=ISD_MOU*3;
END;
ELSE IF PLAN='PPM30' THEN DO;
LOCAL_REV=LOCAL_MOU*.30;
STD_REV=STD_MOU*.30;
ISD_REV=ISD_MOU*4;
END;
ELSE IF PLAN='PPS30' THEN DO;
LOCAL_REV=LOCAL_MOU*.30;
STD_REV=STD_MOU*.30;
ISD_REV=ISD_MOU*5;
END;
TOTAL_MOU=LOCAL_MOU+STD_MOU+ISD_MOU;
TOTAL_REV=LOCAL_REV+STD_REV+ISD_REV;
RUN;

PROC PRINT DATA=MOBILE_USAGE_REV;
RUN;


DATA MED_ALL;
SET SSN2.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE NO_OF_TRIPS SPENT_AMOUNT;
RUN;

DATA MED_APPOLO MED_CIPLA MED_GENO MED_RELEGARE MED_OTHERS;
SET MED_ALL;
IF COMPANY='APPOLO' THEN OUTPUT MED_APPOLO;
ELSE IF COMPANY='CIPLA' THEN OUTPUT MED_CIPLA;
ELSE IF COMPANY='GENO' THEN OUTPUT MED_GENO;
ELSE IF COMPANY='RELEGARE' THEN OUTPUT MED_RELEGARE;
ELSE OUTPUT MED_OTHERS;
RUN;


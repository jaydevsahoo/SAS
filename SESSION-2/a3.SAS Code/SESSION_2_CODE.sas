/* DO WE FOLLOW ANY CRITERIA TO CRAETE A FORMAT NAME */
/* ANS IS YES */
/* IT IS AS SAME AS DATASET AND VARIABLES NAME CRITERIA */

/* MOST IMPORTANTLY IN TEH INTERVIEW WE HAVE ASKED THIS QUESTION */

/* WHAT IS THE DIFFERENCE BETWEEN WHERE AND IF STATEMENT */


DATA STAFF_BONUS;
SET SSN2.STAFF;
IF JOBTITLE='Mechanic' AND SALARY >= 50000 THEN BONUS=.20*SALARY;
ELSE IF JOBTITLE='Mechanic' AND SALARY < 50000 THEN BONUS=.40*SALARY;
ELSE IF JOBTITLE='Pilot' AND SALARY >= 90000 THEN BONUS=.20*SALARY;
ELSE BONUS=.40*SALARY;
NEW_SALARY=SALARY+BONUS;
FORMAT SALARY NEW_SALARY BONUS DOLLAR15.;
RUN;

/* IF STATEMENT GOES WITH DATA STEP ONLY */

DATA STAFF_BONUS;
SET SSN2.STAFF;
IF JOBTITLE='Mechanic' AND SALARY >= 50000 THEN BONUS=.20*SALARY;
ELSE IF JOBTITLE='Mechanic' AND SALARY < 50000 THEN BONUS=.40*SALARY;
ELSE IF JOBTITLE='Pilot' AND SALARY >= 90000 THEN BONUS=.20*SALARY;
ELSE BONUS=.40*SALARY;
NEW_SALARY=SALARY+BONUS;
FORMAT SALARY NEW_SALARY BONUS DOLLAR15.;
WHERE JOBTITLE='Mechanic';
RUN;


PROC PRINT DATA=SSN2.STAFF;
VAR LAST_NAME FIRST_NAME JOBTITLE SALARY;
WHERE JOBTITLE='Pilot';
RUN;

/* WHERE STATEMENT GOES WITH DATA STEP AND PROC STEP BOTH */


PROC PRINT DATA=SSN2.STAFF;
VAR LAST_NAME FIRST_NAME JOBTITLE SALARY;
IF JOBTITLE='Pilot';
RUN;

/* WE CAN NOT USE IF STATEMENT IN PROC STEP */

/* IF TAKES MORE TIME TO PROCESS DATA AND WHERE TAKES LESS TIME TO PROCESS DATA */

/* HOW TO PRINT LIMITED OBSERVATIONS OF A DATASET */

PROC PRINT DATA=SSN2.STAFF;
RUN;

PROC PRINT DATA=SSN2.STAFF (OBS=5);
RUN;

PROC PRINT DATA=SSN2.STAFF (FIRSTOBS=5 OBS=10);
RUN;

PROC PRINT DATA=SSN2.STAFF (FIRSTOBS=10 OBS=10);
RUN;













































 
 




































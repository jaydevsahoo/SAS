/* LOGICAL OPERATOR (AND,OR,IN)*/
DATA MED_2022(KEEP=CUSTOMER_ID	Company	CARD_REG_DATE	CARD_ACTIVE	FIRST_USE_DTE	firstSTOR	TITLE	GENDER STATE_CODE);
SET SSN2.MED_2022;
WHERE Company IN ('MED +' 'GSK' 'APPOLO') AND STATE_CODE IN ('QLD' 'NSW');
RUN;

DATA MED_2022(KEEP=CUSTOMER_ID	Company	CARD_REG_DATE	CARD_ACTIVE	FIRST_USE_DTE	firstSTOR	TITLE	GENDER STATE_CODE);
SET SSN2.MED_2022;
WHERE Company='APPOLO' OR GENDER='Male;
RUN;

DATA MED_2022(KEEP=CUSTOMER_ID	Company	CARD_REG_DATE	CARD_ACTIVE	FIRST_USE_DTE	firstSTOR	TITLE	GENDER STATE_CODE);
SET SSN2.MED_2022;
WHERE Company in ('APPOLO','MED +') OR GENDER='Male;
RUN;

/* COMPARISION  */
DATA MED_2022 (KEEP=CUSTOMER_ID	Company Age Average_Qty_PER_ACC	Spent_amount);
SET SSN2.MED_2022;
WHERE Company IN ('MED +' 'GSK') AND Spent_amount>=1000;
RUN;

DATA MED_2022 (KEEP=CUSTOMER_ID	Company Age Average_Qty_PER_ACC	Spent_amount);
SET SSN2.MED_2022;
WHERE Company NE 'GSK' AND Spent_amount>=1000;
RUN;

/* SPECIAL OPERATOR (LIKE,BETWEEN AND) */

DATA MED_2022 (KEEP=CUSTOMER_ID	Company Age Average_Qty_PER_ACC	Spent_amount);
SET SSN2.MED_2022;
WHERE Company='GSK' AND Spent_amount>=1000 AND Age BETWEEN 20 AND 40;
RUN;

DATA MED_2022 (KEEP=CUSTOMER_ID	Company Age Average_Qty_PER_ACC	Spent_amount TOWN);
SET SSN2.MED_2022;
WHERE Company='GSK' AND TOWN LIKE 'K%';
RUN;

/* ARITHMATIC  */
DATA ABCD;
ADD=100+300;
SUB=100-300;
MUL=100*300;
DIV=100/300;
RUN;

DATA MED_2022 (KEEP=CUSTOMER_ID	Company Age NO_OF_TRIPS	Spent_amount TOWN SPENT_PER_VISIT);
SET SSN2.MED_2022;
SPENT_PER_VISIT=Spent_amount/NO_OF_TRIPS;
FORMAT Spent_amount SPENT_PER_VISIT DOLLAR.;
RUN;

/* WE HAVE SSN2.STAFF DATASET */
/* WE WANT TO GET CUSTOMER_NAME STARTS WITH L AND JOBTITLE IS MECHANIC AND THE SALARY >= 50000 */

DATA STAFF;
SET SSN2.STAFF;
WHERE LAST_NAME LIKE 'L%' AND DESIGNATION='Mechanic' AND SALARY>=50000;
RUN;





















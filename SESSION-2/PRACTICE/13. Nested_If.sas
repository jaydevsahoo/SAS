DATA PROD_CITY_SALES;
INFILE CARDS DSD DLM='09'X;
INPUT PRODUCT $	CITY :$15.	PRICE	UNITS;
CARDS;
APPLE	BANGALORE	36000	838
APPLE	DELHI	49000	836
APPLE	BHUBANESWAR	44000	555
APPLE	MUMBAI	32000	841
APPLE	CHENNAI	38000	767
DELL	BANGALORE	49000	535
DELL	DELHI	35000	183
DELL	BHUBANESWAR	48000	729
DELL	MUMBAI	45000	557
DELL	CHENNAI	31000	490
HP	BANGALORE	43000	596
HP	DELHI	33000	136
HP	BHUBANESWAR	48000	691
HP	MUMBAI	39000	309
HP	CHENNAI	48000	312
;
RUN;
PROC PRINT DATA=PROD_CITY_SALES;
RUN;

/* IF PRODUCT='APPLE' AND CITY='BANGALORE' THEN DISCOUNT OF .30 ON PRICE */
/* IF PRODUCT='APPLE' AND CITY='MUMBAI' THEN DISCOUNT OF .40 ON PRICE */
/* IF PRODUCT='DELL' AND CITY='CHENNAI' THEN DISCOUNT OF .10 ON PRICE */
/* IF PRODUCT='DELL' AND CITY='DELHI' THEN DISCOUNT OF .30 ON PRICE */
/* IF PRODUCT='HP' AND CITY='BHUBANESWAR' THEN DISCOUNT OF .20 ON PRICE */
/* IF PRODUCT='HP' AND CITY='BANGALORE' THEN DISCOUNT OF .50 ON PRICE */

/* NESTED IF CONDITIONS IN SAS PROGRAMMING */
DATA PROD_CITY_SALES_V1;
SET PROD_CITY_SALES;
IF PRODUCT='APPLE' THEN DO;
	IF CITY='BANGALORE' THEN DISCOUNT=PRICE*0.3;
	ELSE IF CITY='MUMBAI' THEN DISCOUNT=PRICE*0.4;
	ELSE DISCOUNT=0;
END;	
ELSE IF PRODUCT='DELL' THEN DO;
	IF CITY='CHENNAI' THEN DISCOUNT=PRICE*0.1;
	ELSE IF CITY='DELHI' THEN DISCOUNT=PRICE*0.3;
	ELSE DISCOUNT=0;
END;	
ELSE IF PRODUCT='HP' THEN DO;
	IF CITY='BHUBANESWAR' THEN DISCOUNT=PRICE*0.2;
	ELSE IF CITY='BANGALORE' THEN DISCOUNT=PRICE*0.5;
	ELSE DISCOUNT=0;
END;	
NEW_SELLING_PRICE=PRICE+DISCOUNT;
RUN;
PROC PRINT DATA=PROD_CITY_SALES_V1;
RUN;













































DATA MOBILE_USAGE;
INPUT MOBILE PLAN $ LOCAL_MOU STD_MOU ISD_MOU;
CARDS;
8951108662 PPS60 800 1000 100
8951108663 PPM30 1000 400 50
8951108664 PPS30 2000 1000 20
;
RUN;

PROC PRINT DATA=MOBILE_USAGE;
RUN;

/* PLAN AND BENEFITS */
/* PPS60 - LOCAL AND STD 1P/1SEC (60P/1M), RS3/1 MINUTE ISD CALLS */
/* PPM30 - LOCAL AND STD (30P/1M), RS4/1 MINUTE ISD CALLS */
/* PPS60 - LOCAL AND STD .5P/1SEC (30P/1M), RS5/1 MINUTE ISD CALLS */

/* CALCULATE THE USAGE REVENUE FOR LOCAL,STDAND ISD CALLS */
DATA MOB_USAGE;
SET MOBILE_USAGE;
IF PLAN='PPS60' THEN DO;
	LOCAL_REVENUE=LOCAL_MOU*0.6;
	STD_REVENUE=STD_MOU*60;
	ISD_REVENUE=ISD_MOU*3;
END;	
ELSE IF PLAN='PPM30' THEN DO;
	LOCAL_REVENUE=LOCAL_MOU*0.3;
	STD_REVENUE=STD_MOU*0.3;
	ISD_REVENUE=ISD_MOU*4;
END;	
ELSE IF PLAN='PPS30' THEN DO;
	LOCAL_REVENUE=LOCAL_MOU*0.3;
	STD_REVENUE=STD_MOU*0.3;
	ISD_REVENUE=ISD_MOU*5;
END;	
TOT_MOU=LOCAL_MOU+STD_MOU+ISD_MOU;
TOT_REV=LOCAL_REVENUE+STD_REVENUE+ISD_REVENUE;
RUN;

PROC PRINT DATA=MOB_USAGE;
RUN;

/* DIFF B/W IF....THEN AND IF...THEN...DO ? */
/* 1. IF....THEN ->For one conditional variables */
/* 2. IF...THEN...DO ->For multiple cnditional variables */


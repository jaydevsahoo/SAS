DATA STU_SCORE;
INPUT NAME $ SUBJECT $ SCORE;
CARDS;
TONY SAS 90
TONY SQL 89
TONY EXCEL 98
TONY EXCEL 98
STARK SAS 95
STARK SAS 95
STARK EXCEL 99
STARK PYTHON 78
;
RUN;

PROC SORT DATA=STU_SCORE;
BY NAME SUBJECT;
RUN;

DATA STU_SCORE_1;
SET STU_SCORE;
RUN;

DATA STU_SCORE_2;
SET STU_SCORE;
RUN;


/* REMOVE DUPLICATES  NODUPKEY AS OPTION*/
PROC SORT DATA=STU_SCORE_1 NODUPKEY DUPOUT=STU_SCORE_V2;
BY NAME;
RUN;

PROC PRINT DATA=STU_SCORE_1;
RUN;

PROC PRINT DATA=STU_SCORE_V2;
RUN;


/* GET PERFECT O/P (NODUP AS OPTION) */
PROC SORT DATA=STU_SCORE_2 NODUP DUPOUT=STU_SCORE_V2;
BY NAME;
RUN;

PROC PRINT DATA=STU_SCORE_2;
RUN;

PROC PRINT DATA=STU_SCORE_V2;
RUN;


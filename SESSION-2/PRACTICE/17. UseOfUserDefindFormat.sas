/* $ABBR FORMAT TYPE CREATION*/
PROC FORMAT;
VALUE $ABBR 'WA'='WESTERN AUSTRALIA'
            'NSW'='NEW SOUTH WALES'
            'VIC'='VICTORIA'
            'ACT'='AUSTRALIAN CAPITAL TERRITORY'
            'SA'='SOUTH AUSTRALIA'
            'NT'='NORTHEN TERRITORY'
            'QLD'='QUEENSLAND';
RUN;  
/* AGE_BUCKET FORMAT CREATION*/
PROC FORMAT;
VALUE  AGE_BUCKET  LOW-<30='YOUNG' 31-40='MID_YOUNG_AGE' 41-50='MID_AGE'
					51-60='MID_OLD_AGE' 60<-HIGH='OLD';
RUN;
/* TRIP_BUCKET FORMAT CREATION*/
PROC FORMAT;
VALUE TRIP_BUCKET LOW-<10='CASUAL' 10-30='POWER' 30<-HIGH='REGULAR';
RUN;
/* SPENT_BUCKET FORMAT CREATION*/
PROC FORMAT ;
VALUE SPENT_BUCKET LOW-<500='RETAIL' 500-1000='ADVANCE' 1000<-HIGH='PREMIER';
RUN;

/*  APPLY FORMAT TYPES TO DATASET=MED_APPOLO */
DATA MED_APPOLO(KEEP=CUSTOMER_ID Company GENDER Age STATE_CODE Spent_amount AGE_BUCKET TRIP_BUCKET SPENT_BUCKET);
SET SSN2.MED_APPOLO;
AGE_BUCKET=AGE;
TRIP_BUCKET=NO_OF_TRIPS;
SPENT_BUCKET=Spent_amount;
FORMAT STATE_CODE $ABBR. AGE_BUCKET AGE_BUCKET. TRIP_BUCKET TRIP_BUCKET. SPENT_BUCKET SPENT_BUCKET.
RUN;   
PROC PRINT DATA=MED_APPOLO;RUN;
             
 
/*  APPLY FORMAT TYPES TO DATASET=MED_CIPLA */                
DATA  MED_CIPLA;
SET SSN2.med_cipla;
AGE_BUCKET=AGE;
TRIP_BUCKET=NO_OF_TRIPS;
SPENT_BUCKET=Spent_amount;
FORMAT STATE_CODE $ABBR. AGE_BUCKET AGE_BUCKET. TRIP_BUCKET TRIP_BUCKET. SPENT_BUCKET SPENT_BUCKET.
RUN;              					
PROC PRINT DATA=MED_CIPLA;RUN;					       

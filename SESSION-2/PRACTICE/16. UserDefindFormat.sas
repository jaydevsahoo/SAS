DATA STU_SCORE;
INPUT STU_NAME $ SCORE;
CARDS;
S1 80
S2 45
S3 57
S4 23
S5 35
;
RUN;

PROC PRINT DATA=STU_SCORE;RUN;

PROC FORMAT ;
VALUE $NAME 'S1'='TONY' 'S2'='STARK' 'S3'='STEVE' 'S4'='ROGERS' 'S5'='WANDA';
RUN;

PROC FORMAT ;
VALUE DIVISION 0-30='FAIL' 31-40='PASS' 41-50='3RD' 51-60='2ND' 61-100='1ST';
RUN;

DATA STU_SCORE_V1;
SET STU_SCORE;
FORMAT STU_NAME $NAME. SCORE DIVISION.;
RUN;
PROC PRINT DATA=STU_SCORE_V1;












































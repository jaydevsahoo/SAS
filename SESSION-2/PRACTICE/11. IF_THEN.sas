/* AGE BUCKET,SPENT BUCKET, VISIT BUCKET */

DATA MED_2022(KEEP=CUSTOMER_ID COMPANY GENDER 
AGE STATE_CODE NO_OF_TRIPS SPENT_AMOUNT AGE_BUCKET VISIT_BUCKET);
SET SSN2.med_2022;
LENGTH AGE_BUCKET VISIT_BUCKET $30.;
IF AGE>=60 THEN AGE_BUCKET='OLD_AGE';
ELSE IF AGE>=50 THEN AGE_BUCKET='MID-OLD-AGE';
ELSE IF AGE >= 40 THEN AGE_BUCKET='MID-AGE';
ELSE IF AGE >= 30 THEN AGE_BUCKET='MID-YOUNG-AGE';
ELSE AGE_BUCKET='YOUNG-AGE';

IF NO_OF_TRIPS >= 30 THEN VISIT_BUCKET='REGULAR';
ELSE IF NO_OF_TRIPS >= 10 THEN VISIT_BUCKET='POWER';
ELSE VISIT_BUCKET='CASUAL';

RUN;


/* EX-2 */
/* CREATE BONUS CY CONDITION AND IF THEN */
/* IF THEN LOGIC BY EXAMPLE */
/* IN THE STAFF DATASET, WE WILL CREATE A BONUS VARIABLE */
/* IF JOBTITLE='MECHANIC' AND SALARY >= 50000 THEN BONUS=.20*SALARY */
/* IF JOBTITLE='MECHANIC' AND SALARY < 50000 THEN BONUS=.40*SALARY */
/* IF JOBTITLE='PILOT' AND SALARY >= 90000 THEN BONUS=.20*SALARY */
/* IF JOBTITLE='PILOT' AND SALARY < 90000 THEN BONUS=.40*SALARY */

DATA STAFF;
SET SSN2.STAFF;
IF DESIGNATION='Mechanic' and SALARY>=50000 THEN BONUS=0.2*SALARY;
ELSE IF DESIGNATION='Mechanic' and SALARY<50000 THEN BONUS=0.4*SALARY;
ELSE IF DESIGNATION='Pilot' and SALARY>= 90000 THEN BONUS=0.2*SALARY;
ELSE BONUS=0.4*SALARY;
NEW_SALARY=SALARY+BONUS;
FORMAT SALARY NEW_SALARY BONUS DOLLAR12.;
RUN;


/* What is difference between WHERE and IF statement */
/* IF Statement can co with DATA STEP ONLY */
/* WHERE statement can go with both DATA STEP AND PROC STEP */
PROC PRINT DATA=SSN2.STAFF;
VAR LAST_NAME FIRST_NAME DESIGNATION SALARY;
WHERE DESIGNATION='Pilot';
run;

/* WE CANT RUN IF inside PROC statement */





















/* =================================TASK-8================================= */
PROC IMPORT OUT=SSN2_TST.LOANS
			DATAFILE='/home/u61735472/BATCH_202203/A2.SESSION-2/RAW DATA/Loans.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='DATA';
RUN;			

/* Q1, Q2 */

DATA LOANS;
SET SSN2_TST.LOANS;
BALANCE_PERCENTAGE=BALANCE/LOAN_AMOUNT;
FORMAT BALANCE_PERCENTAGE PERCENT10.2;

IF BALANCE_PERCENTAGE<=0.3 THEN BALANCE_BUCKET='LOW BALANCE';
ELSE IF BALANCE_PERCENTAGE>0.3 AND  BALANCE_PERCENTAGE<=0.5 THEN BALANCE_BUCKET='MID BALANCE';
ELSE BALANCE_BUCKET='HIGH BALANCE';

IF DELINQUENCY_DAYS=0 THEN DELINQUENT_STATUS='NON_DELINQUENT';
ELSE DELINQUENT_STATUS='DELINQUENT';

IF DELINQUENCY_DAYS=0 THEN DELINQUENCY_BUCKET='CURRENT';
ELSE IF DELINQUENCY_DAYS>180 THEN DELINQUENCY_BUCKET='CHARGE OFF';
ELSE IF DELINQUENCY_DAYS>150 THEN DELINQUENCY_BUCKET='X+5 DAYS';
ELSE IF DELINQUENCY_DAYS>120 THEN DELINQUENCY_BUCKET='X+4 DAYS';
ELSE IF DELINQUENCY_DAYS>90 THEN DELINQUENCY_BUCKET='X+3 DAYS';
ELSE IF DELINQUENCY_DAYS>60 THEN DELINQUENCY_BUCKET='X+2 DAYS';
ELSE IF DELINQUENCY_DAYS>30 THEN DELINQUENCY_BUCKET='X+1 DAYS';
ELSE DELINQUENCY_BUCKET='X DAYS';

IF CURRENT_SCORE < ORIGINATION_SCORE THEN SCORE_INDICATOR='LOW';
ELSE SCORE_INDICATOR='PAR';

IF PORTFOLIO='HOME LOAN' AND DELINQUENT_STATUS='DELINQUENT' THEN DO;
	IF BALANCE_BUCKET='HIGH BALANCE' THEN  RISK_SEGMENT='HIGH';
	ELSE IF BALANCE_BUCKET='MID BALANCE' THEN  RISK_SEGMENT='MID';
	ELSE RISK_SEGMENT='LOW';
END;	
IF PORTFOLIO='PERSONAL LOAN' AND DELINQUENT_STATUS='DELINQUENT' THEN DO;
	IF BALANCE_BUCKET='HIGH BALANCE' THEN  RISK_SEGMENT='HIGH';
	ELSE IF BALANCE_BUCKET='MID BALANCE' THEN  RISK_SEGMENT='MID';
	ELSE RISK_SEGMENT='LOW';
END;
IF PORTFOLIO='CREDIT CARD' AND DELINQUENT_STATUS='DELINQUENT' THEN DO;
	IF BALANCE_BUCKET='HIGH BALANCE' THEN  RISK_SEGMENT='HIGH';
	ELSE IF BALANCE_BUCKET='MID BALANCE' THEN  RISK_SEGMENT='MID';
	ELSE RISK_SEGMENT='LOW';
END;
IF PORTFOLIO='OVERDRAFT' AND DELINQUENT_STATUS='DELINQUENT' THEN DO;
	IF BALANCE_BUCKET='HIGH BALANCE' THEN  RISK_SEGMENT='HIGH';
	ELSE IF BALANCE_BUCKET='MID BALANCE' THEN  RISK_SEGMENT='MID';
	ELSE RISK_SEGMENT='LOW';
END;
RUN;



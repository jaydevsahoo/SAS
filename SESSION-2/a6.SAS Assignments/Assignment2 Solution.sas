/* =================================TASK-4================================= */

PROC IMPORT OUT=SSN2_TST.TELECOMM
			DATAFILE='/home/u61735472/BATCH_202203/A2.SESSION-2/RAW DATA/TELECOMM.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='DATA';
RUN;	

/* Q1 Q2 Q3*/
	
DATA TELECOMM1;
SET SSN2_TST.TELECOMM;
IF VOICE<=500 THEN VOICE_SEGMENT='LV';
ELSE IF VOICE >500 AND VOICE<=1000 THEN VOICE_SEGMENT='MV';
ELSE VOICE_SEGMENT='HV';

IF DATA<=5 THEN DATA_SEGMENT='LD';
ELSE IF DATA>5 AND DATA<=20 THEN DATA_SEGMENT='MD';
ELSE DATA_SEGMENT='HD';

IF VOICE_SEGMENT='HV' THEN DO;
	IF DATA_SEGMENT='HD' THEN CUSTOMER_SEGMENT='BONAFIED';
	ELSE IF DATA_SEGMENT='LD' THEN CUSTOMER_SEGMENT='POWER_VOICE';
	ELSE CUSTOMER_SEGMENT='POWER';	
END;
IF VOICE_SEGMENT='LV' THEN DO;
	IF DATA_SEGMENT='HD' THEN CUSTOMER_SEGMENT='POWER_DATA';
	ELSE IF DATA_SEGMENT='MD' THEN CUSTOMER_SEGMENT='CASUAL';
	ELSE CUSTOMER_SEGMENT='CASUAL';	
END;	
IF VOICE_SEGMENT='MD' AND DATA_SEGMENT='HD' THEN CUSTOMER_SEGMENT='POWER';
IF VOICE_SEGMENT='MV' THEN DO;
	IF DATA_SEGMENT='MD' THEN CUSTOMER_SEGMENT='CASUAL';
	ELSE CUSTOMER_SEGMENT='CASUAL';
END;	
RUN;	


/* =================================TASK-5================================= */

PROC IMPORT OUT=SSN2_TST.COURSE
			DATAFILE='/home/u61735472/BATCH_202203/A2.SESSION-2/RAW DATA/COURSE.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='DATA';
RUN;			

/* Q2 */
DATA SSN2_TST.COURSE_V1;
SET SSN2_TST.COURSE;
IF ENVIRONMENT='PANDEMIC' THEN DO;
	IF COURSE='ADA' THEN DO;
		IF TOOL='SQL' THEN DISCOUNT=0.1*FEE;
		ELSE IF TOOL='PYTHON' THEN DISCOUNT=0.1*FEE;
		ELSE IF TOOL='SAS' THEN DISCOUNT=0.2*FEE;
		ELSE IF TOOL='R' THEN DISCOUNT=0.1*FEE;
		ELSE IF TOOL='ADVANCED ANALYTICS' THEN DISCOUNT=0.1*FEE;
		ELSE DISCOUNT=0;
	END;
	IF COURSE='DAS' AND TOOL='SAS' THEN DISCOUNT=0.2*FEE;
	IF COURSE='MINI MODULE' THEN DO;
		IF TOOL='TABLEAU' THEN DISCOUNT=0.1*FEE;
		ELSE IF TOOL='POWER BI' THEN DISCOUNT=0.1*FEE;
		ELSE DISCOUNT=0;
	END;	
	IF COURSE='MPIDS' THEN DO;
		IF TOOL='SAS' THEN DISCOUNT=0.2*FEE;
		ELSE IF TOOL='POWER BI' THEN DISCOUNT=0.3*FEE;
		ELSE IF TOOL='ADVANCED ANALYTICS' THEN DISCOUNT=0.1*FEE;
		ELSE IF TOOL='MACHINE LEARNING' THEN DISCOUNT=0.2*FEE;
		ELSE DISCOUNT=0;
	END;
END;
ELSE DISCOUNT=0;
FINAL_FEE=FEE-DISCOUNT;
RUN;
		


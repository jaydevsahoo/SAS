PROC IMPORT OUT=SSN2_TST.MED_BASE
			DATAFILE='/home/u61735472/BATCH_202203/A2.SESSION-2/RAW DATA/A1.MED_STORE_DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='Sheet3';
RUN;	

/* Q1 Q2 Q3*/
DATA MED_BASE;
SET SSN2_TST.MED_BASE;
TOTAL_BASE=JAN+FEB+MAR+APR+MAY+JUN+JUL+AUG+SEP+OCT+NOV+DEC;
QTR1=JAN+FEB+MAR;
QTR2=APR+MAY+JUN;
QTR3=JUL+AUG+SEP;
QTR4=OCT+NOV+DEC;
QTR1_PERCENT=QTR1/TOTAL_BASE;
QTR2_PERCENT=QTR2/TOTAL_BASE;
QTR3_PERCENT=QTR3/TOTAL_BASE;
QTR4_PERCENT=QTR4/TOTAL_BASE;
FORMAT QTR1_PERCENT QTR2_PERCENT QTR3_PERCENT QTR4_PERCENT PERCENT10.2;
RUN;




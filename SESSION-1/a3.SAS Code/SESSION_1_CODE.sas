/* LIBRARY NAME CRITERIAS */
/* 1. IT SHOULD NOT BE MORE THAN 8 CHARACTERS LONG */
/* 2. IT MUST START WITH AN ALPHABET OR AN UNDERSCORE ONLY */
/* 3. IT MUST BE FOLLOWED WITH ALPHABET,UNDERSCORE AND NUMBERS ONLY */

/* EX: FOR TEST */
/* AUSTRALIA_2020 ------  NO */
/* AUS_2020 ------- YES */
/* AUS@2020 ------ NO */
/* 2020_AUS ----- NO */
/* _AUS_2020 ---- NO */
/* _AUS2020 ---- YES */

/* DATASET AND VARIABLE NAME CRITERIAS */
/* 1. IT SHOULD NOT BE MORE THAN 32 CHARACTERS LONG */
/* 2. IT MUST START WITH AN ALPHABET OR AN UNDERSCORE ONLY */
/* 3. IT MUST BE FOLLOWED WITH ALPHABET,UNDERSCORE AND NUMBERS ONLY */

/* EX: FOR TEST */

/* DATASET NAME */
/* SALES_2020_AUSTRALIA ------  YES */
/* AUSTRALIA_2020_INDIA_EXPORT_DATA ---- YES */
/* AUSTRALIA 2020_SALES ----- NO */

/* VARIABLE NAME */
/* LAST_NAME -----YES */
/* LAST NAME ---- NO */

/* VARIABLE TYPES */
/* ======================= */
/* VARIABLE ARE 2 TYPES */
/* 1. CHARACTER VARIABLE (ALPHANUMERIC) */
/* 2. NUMERIC VARIABLE (DATETIME) */


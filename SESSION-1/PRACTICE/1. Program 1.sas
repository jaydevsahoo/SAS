/* CREATE A DATASET */
DATA TABLE1;
INPUT NAME $ GENDER $ AGE EDUCATION $ DOB COURSE $;
INFORMAT DOB DDMMYY10.; /* Read data into SAS format */
FORMAT DOB DDMMYY10.; /* write data into SAS format */
CARDS;
S1  MALE  24  BTECH  23-06-1993  ABC
S2  MALE  25  BTECH  24-03-1998  DEF
S3  MALE  26  MCA  02-06-1990  ABC
S4  FEMALE  27  MTECH  20-07-1993  DEF
;
RUN;

PROC PRINT DATA=TABLE1;
RUN;

/* CREATE A DATASET */
DATA TABLE2;
INPUT ID $ NAME : $30. AGE DOB COURSE $;
INFORMAT DOB DDMMYY10.;
FORMAT DOB MMDDYY10.;
CARDS; /*to put temporary data into the table */
S1 AV11222222 26 23-06-1993 ABC
S2 AV244444 24 24-03-1998 DEF
S3 AV3 24 02-06-1990 ABC
S4 AV4 26 20-07-1993 DEF
S5 AV5 25 22-06-1993 ABC
S6 AV6 29 24-06-1993 DEF
S7 AV7 25 25-06-1993 ABC
S8 AV8 28 26-06-1993 DEF
S9 AV9 26 27-06-1993 ABC
;
RUN;

PROC PRINT DATA=TABLE2; /* to print result of dataset */
RUN;


/* DATASET AND VARIABLE NAME CRITERIAS */
/* 1. IT SHOULD NOT BE MORE THAN 32 CHARACTERS LONG */
/* 2. IT MUST START WITH AN ALPHABET OR AN UNDERSCORE ONLY */
/* 3. IT MUST BE FOLLOWED WITH ALPHABET,UNDERSCORE AND NUMBERS ONLY */

/* VARIABLES VALUES */
/* ========================= */
/* 1. DEFAULT CHARACTER VARIABLE LENGTH IS 8 CHARACTERS */
/* 2. MAXIMUM CHARACTER VARIABLE LENGTHS CAN BE 32,767 CHARACTERS */
/* 3. DEFAULT NUMERIC VARIABLES VALUES LENGTH IN 8 BYTES (16-17 DIGITS) */

/* Ex */
DATA SSN1.TABLE2;
INPUT ID $ NAME $ AGE DOB COURSE $;
INFORMAT DOB DDMMYY10.;
FORMAT DOB DATE9.;
CARDS; /*to put temporary data into the table */
S1 AV11222222232322 26 23-06-1993 ABC
S2 AV244444 24 24-03-1998 DEF
S3 AV3 24 02-06-1990 ABC
S4 AV4 26 20-07-1993 DEF
S5 AV5 25 22-06-1993 ABC
S6 AV6 29 24-06-1993 DEF
S7 AV7 25 25-06-1993 ABC
S8 AV8 28 26-06-1993 DEF
S9 AV9 26 27-06-1993 ABC
;
RUN;

PROC PRINT DATA=SSN1.TABLE2; /* to print result of dataset */
RUN;












































































































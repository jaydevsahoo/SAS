/* IN PDV, WE UNDERSTAND */
/*  */
/* WHEN WE RUN THE SAS CODE DATA STEP */
/* IT RUNS IN 2 PHASES */
/* 1. COMPILATION */
/* 2. EXECUTION */
/*  */
/* BEFORE RUN STATEMENT IS ALL CALLED AS COMPILATON CODE */
/* DURING COMPILATION, IF SAS GETS ANY ERROR, IT THROUGHS IN TEH LOG WINDOW AS */
/* _ERROR_=1 _N_=2 */
/* _ERROR_=1 _N_=3 */
/* _ERROR_=1 _N_=10 */

/* ONCE WE READ THIS ERROR, WE CAN FIND THE RIGHT OPTIONS TO BE USED FOR READING DATA CORRECTLY */

/* SCENARIO-13 */
/* HOW TO CRAETE A A ROW NUMBER IN A DATASET */

DATA MED_SELECT;
SET SSN3.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE SPENT_AMOUNT ROW_NUM;
ROW_NUM=_N_;
RUN;

PROC PRINT DATA=MED_SELECT;
RUN;

/* SCENARIO-14 */

/* HOW TO CREATE A NEW DATASET BY SELECTING FEW OBSERVATIONS */

DATA MED_SELECT_V1;
SET MED_SELECT (OBS=200);
RUN;

PROC PRINT DATA=MED_SELECT_V1;
RUN;

DATA MED_SELECT_V1;
SET MED_SELECT ;
WHERE ROW_NUM BETWEEN 100 AND 200;
RUN;

PROC PRINT DATA=MED_SELECT_V1;
RUN;

/* SCENARIO-15 */
/* HOW TO CREATE A NEW DATASET BY SELECTING RANDOM OBSERVATIONS */

PROC SURVEYSELECT DATA=MED_SELECT METHOD=SRS N=100 OUT=MED_SAMPLE;
RUN;

PROC PRINT DATA=MED_SAMPLE;
RUN;

/* HOW TO CREATE A DATASET HAVING EVERY 5TH ALTERNATIVE ROW NUMBER */

DATA MED_SELECT_V1;
SET MED_SELECT ;
WHERE MOD(ROW_NUM,5)=0;
RUN;

PROC PRINT DATA=MED_SELECT_V1;
RUN;

DATA MED_SELECT_V1;
SET MED_SELECT ;
WHERE MOD(ROW_NUM,2)<>0;
RUN;

PROC PRINT DATA=MED_SELECT_V1;
RUN;




































































/* 2. READING DATA FROM SQL SERVER */

LIBNAME SQLDB SQL USER=DEVD PASSWORD=DEV@123   PATH=BATCH_202204;
RUN;

DATA MED_2022;
SET SQLDB.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE SPENT_AMOUNT;
WHERE COMPANY='APPOLO';
RUN;


PROC SQL;
CONNECT TO SQL (USER=DEVD PASSWORD=DEV@123   PATH=BATCH_202204);
CREATE TABLE MED_2022
AS
(SELECT
CUSTOMER_ID,
COMPANY,
GENDER,
AGE,
STATE_CODE,
SPENT_AMOUNT
FROM MED_2022
WHERE COMPANY='APPOLO' AND GENDER='Female' AND AGE >= 50);
QUIT;


/* What are options we can use in INFILE statement? */
/* Ans=DLM, DSD,MISSOVER,TRUNCOVER,IRECL,FIRSTOBS */

/* SCENARIO-11 */
/* READ MULTIPLE OBSERVATIONS IN SINGLE LINE USE @@ END OF INPUT*/

DATA AV_ENQ;
INPUT NAME :$ 15. AGE GENDER $ @@;
CARDS;
TONY 25 MALE STARK 25 MALE STEVE 100 MALE ROGERS 100 MALE WANDA 36 FEMALE
THOR 200 MALE GROOT 25 MALE
;
RUN;
PROC PRINT DATA=AV_ENQ;RUN;
/* SCENARIO-12 */
/* USE OF @ */
/*
101 USA 1-20-1999 3295.50 
3034 EUR 30JAN1999 1876,30
101 USA 1-30-1999 2938.00
128 USA 2-5-1999 2908.74
1345 EUR 6FEB1999 3145,60
109 USA 3-17-1999 2789.10
*/
DATA SALES;
INFILE '/home/u61735472/BATCH_202203/A3.SESSION-3/RAW DATA/A4.FlatFile/A12.Location.txt';
INPUT ID COUNTRY $ @;
IF LEFT(COUNTRY)='USA' THEN
	INPUT DATE : MMDDYY10. AMOUNT : COMMA15.; /* :->INFORMAT */
ELSE IF LEFT(COUNTRY)='EUR' THEN 
	INPUT DATE :DATE9. AMOUNT : COMMAX15.;
FORMAT DATE MMDDYY10. AMOUNT DOLLAR12.;
RUN;
PROC PRINT DATA=SALES;RUN;



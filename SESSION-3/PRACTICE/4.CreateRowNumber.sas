LIBNAME SSN2 '/home/u61735472/BATCH_202203/A2.SESSION-2/DATASET' ;RUN;

DATA MED_ROW;
SET SSN2.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE SPENT_AMOUNT ROW_NUM;
ROW_NUM=_N_;
RUN;
PROC PRINT DATA=MED_ROW;RUN;


/* HOW TO CREATE A NEW DATASET BY SELECTING FEW OBSERVATIONS */
DATA MED_ROW_V1;
SET MED_ROW (OBS=200);
RUN;
PROC PRINT DATA=MED_ROW_V1;RUN;


DATA MED_ROW_V1;
SET MED_ROW;
WHERE ROW_NUM BETWEEN 100 AND 200;
RUN;
PROC PRINT DATA=MED_ROW_V1;RUN;

/* HOW TO CREATE A NEW DATASET BY SELECTING RANDOM OBSERVATIONS */

PROC SURVEYSELECT DATA=MED_ROW METHOD=SRS N=100 OUT=MED_SAMPLE;
RUN;
PROC PRINT DATA=MED_SAMPLE;RUN;

/* HOW TO CREATE A DATASET HAVING EVERY 5TH ALTERNATIVE ROW NUMBER */
DATA MED_SELECT_V2;
SET MED_ROW;
WHERE MOD(ROW_NUM,5)=0;
RUN;
PROC PRINT DATA=MED_SELECT_V2;RUN;

/* HOW TO CREATE A DATASET HAVING EVERY ODD ALTERNATIVE ROW NUMBER */
DATA MED_SELECT_V3;
SET MED_ROW;
WHERE MOD(ROW_NUM,2)<>0;
RUN;
PROC PRINT DATA=MED_SELECT_V3;RUN;

/* HOW TO CREATE A DATASET HAVING EVERY EVEN ALTERNATIVE ROW NUMBER */
DATA MED_SELECT_V3;
SET MED_ROW;
WHERE MOD(ROW_NUM,2)=0;
RUN;
PROC PRINT DATA=MED_SELECT_V3;RUN;














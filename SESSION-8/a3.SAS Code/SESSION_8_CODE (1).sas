ELSE IF TOTAL_DATA >= 5 THEN DATA_SEGMENT='MD';
ELSE DATA_SEGMENT='LD';

/* CUSTOMER SEGMENT */
IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='HD' THEN CUSTOMER_SEGMENT='A1.BONAFIED';
ELSE IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='MD' THEN CUSTOMER_SEGMENT='A2.POWER';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='HD' THEN CUSTOMER_SEGMENT='A2.POWER';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='MD' THEN CUSTOMER_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='LD' THEN CUSTOMER_SEGMENT='A4.POWER-VOICE';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='HD' THEN CUSTOMER_SEGMENT='A3.POWER-DATA';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='LD' THEN CUSTOMER_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='LD' THEN CUSTOMER_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='MD' THEN CUSTOMER_SEGMENT='A5.CASUAL';
ELSE CUSTOMER_SEGMENT='A5.CASUAL';

RUN;


/* STEP-4 GET CUSTOMER_LEVEL USAGE SUMMARY*/

PROC SQL;
CREATE TABLE SAS_MAC.MOBILE_USAGE_SUMMARY_&YR.
AS
SELECT
MOBILE,
COUNT(CASE WHEN CUSTOMER_SEGMENT='A1.BONAFIED' THEN MOBILE END) AS BONAFIED_USES,
COUNT(CASE WHEN CUSTOMER_SEGMENT='A2.POWER' THEN MOBILE END) AS POWER_USES,
COUNT(CASE WHEN CUSTOMER_SEGMENT='A3.POWER-DATA' THEN MOBILE END) AS POWER_DATA_USES,
COUNT(CASE WHEN CUSTOMER_SEGMENT='A4.POWER-VOICE' THEN MOBILE END) AS POWER_VOICE_USES,
COUNT(CASE WHEN CUSTOMER_SEGMENT='A5.CASUAL' THEN MOBILE END) AS CASUAL_USES,
&YR. AS TELECOM_USAGE_YEAR
FROM TELECOM_USAGE_&YR._SUMMARY
GROUP BY MOBILE;
QUIT;

%MEND;



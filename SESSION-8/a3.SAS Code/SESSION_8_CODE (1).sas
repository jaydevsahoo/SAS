%BABABA (DSN=GSK,COMP=GSK,GEN=Female,AG=40,STCD=NSW);


/* IN KEYWORD PARAMETER , WE CAN INTERCHANGE THE VARIABLES POSITION */
%BABABA (COMP=GENO,DSN=RELEGARE,STCD=QLD,GEN=Male,AG=40);

/* HOWEVER, WE CAN NOT INTERCHANGE THE VARIABLES POSITION USING POSITIONAL PARAMETER */
%HAHAHA (Female,GENO,GENO,40,ACT);


/* 2. KEYWORD PARAMETER */

%MACRO BABABA (DSN=,COMP=,GEN=,AG=,STCD=);
DATA MED_&DSN.;
SET SAS_MAC.MED_2022;
KEEP CUSTOMER_ID COMPANY GENDER AGE STATE_CODE NO_OF_TRIPS SPENT_AMOUNT;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND AGE > &AG. AND STATE_CODE="&STCD.";
RUN;

/* 4 Ways to debug macro programming 
1. %PUT
2. OPTIONS MPRINT
3. OPTIONS MLOGIC
4. OPTIONS SYMBOLGEN
*/
%LET VARS=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT;

/* 2. OPTIONS MPRINT */

OPTIONS MPRINT;
%MACRO MAC(X,COMP,GEN,AGE,STCD);
DATA MED_&X.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND AGE>=&AGE. AND STATE_CODE="&STCD.";
%MEND;

%MAC(APPOLO,APPOLO,Male,35,QLD);

/* 3. OPTIONS MLOGIC */

OPTIONS MLOGIC;
%MACRO MAC2(X,COMP,GEN,AGE,STCD);
DATA MED_&X.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND AGE>=&AGE. AND STATE_CODE="&STCD.";
%MEND;

%MAC2(APPOLO,APPOLO,Male,35,QLD);


/* 4. OPTIONS SYMBOLGEN */

OPTIONS SYMBOLGEN;
%MACRO MAC3(X,COMP,GEN,AGE,STCD);
DATA MED_&X.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND AGE>=&AGE. AND STATE_CODE="&STCD.";
%MEND;

%MAC3(APPOLO,APPOLO,Male,35,QLD);













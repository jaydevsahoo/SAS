/* POSITIONAL PARAMETERS */
/* 
Ex-1 
Create each company wise records using macro? 
*/
%LET VARS=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT;

%MACRO MAC1(DSN,COMP,GEN,AG,STD);
DATA MED_&DSN.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND AGE>&AG. AND STATE_CODE="&STD.";
RUN;
%MEND;
%MAC1(APPOLO,APPOLO,Male,50,NSW);
%MAC1(CIPLA,CIPLA,Female,60,NSW);
%MAC1(MED,MED +,Female,60,NSW);


/* KEYWORD PARAMETERS */
%MACRO MAC2(DSN=,COMP=,GEN=,STD=);
DATA MED_&DSN.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND STATE_CODE="&STD.";
%MEND;
%MAC2(DSN=APPOLO,GEN=Female,COMP=APPOLO,STD=QLD);
%MAC2(DSN=CIPLA,GEN=Male,COMP=CIPLA,STD=WA);
%MAC2(DSN=GSK,GEN=Female,COMP=GSK,STD=QLD);
%MAC2(DSN=X,GEN=Male,COMP=MED +,STD=QLD);

/* Use positional & keyword params together */
%MACRO MAC3(DSN,COMP,GEN=,STD=);
DATA MED_&DSN.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND STATE_CODE="&STD.";
RUN;
%MEND;
%MAC3(APPOLO,APPOLO,GEN=Male,STD=QLD);













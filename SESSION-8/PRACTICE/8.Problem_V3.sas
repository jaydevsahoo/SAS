INPUT USAGE_YEAR : $20.;
CARDS;
USAGE_2016
USAGE_2017
USAGE_2018
USAGE_2019
USAGE_2020
;
RUN;

PROC SQL;
SELECT USAGE_YEAR INTO : X1 -:X5
FROM USAGE;
RUN;

%PUT &X4;

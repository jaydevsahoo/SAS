OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SUMMARY_2016
		    DATAFILE='/home/u61735472/BATCH_202203/A8.SAS_MACRO/RAW_DATA/A2.TELECOM YEARLY USAGE DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='USAGE_2016';
RUN;		
	
PROC SQL;
CREATE TABLE TELECOMM_SUMMARY AS
SELECT MOBILE,YEARMO,
SUM(MOU) AS TOTAL_VOICE,
SUM(DATA) AS TOTAL_DATA
FROM SUMMARY_2016
GROUP BY MOBILE,YEARMO
ORDER BY 1,2;
QUIT;

/* Create segment Data,Voice & Customer segment */
DATA TELECOM_2016_SUMMARY;
SET TELECOMM_SUMMARY;
IF TOTAL_VOICE>=1000 THEN VOICE_SEGMENT='HV';
ELSE IF TOTAL_VOICE>=500 THEN VOICE_SEGMENT='MV';
ELSE VOICE_SEGMENT='LV';

IF TOTAL_DATA>=20 THEN DATA_SEGMENT='HD';
ELSE IF TOTAL_DATA>=5 THEN DATA_SEGMENT='MD';
ELSE DATA_SEGMENT='LD';

IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='HD' THEN CUST_SEGMENT='A1.BONAFIED';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='MD' THEN CUST_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='MD' THEN CUST_SEGMENT='A2.POWER';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='LD' THEN CUST_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='HD' THEN CUST_SEGMENT='A2.POWER';
ELSE IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='LD' THEN CUST_SEGMENT='A4.POWER-VOICE';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='LD' THEN CUST_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='HD' THEN CUST_SEGMENT='A3.POWER-DATA';
ELSE CUST_SEGMENT='A5.CASUAL';
RUN;

/* Get Mobile number(in row) wise count of CUST_SEGMENT(in column) ? */
PROC SQL;
CREATE TABLE MOBILE_USAGE_SUMMARY_2016 AS 
SELECT MOBILE,
COUNT(CASE WHEN CUST_SEGMENT='A1.BONAFIED' THEN MOBILE END )AS BONAFIED_USER,
COUNT(CASE WHEN CUST_SEGMENT='A5.CASUAL' THEN MOBILE END)AS CASUAL_USER,
COUNT(CASE WHEN CUST_SEGMENT='A2.POWER' THEN MOBILE	END)AS POWER_USER,
COUNT(CASE WHEN CUST_SEGMENT='A4.POWER-VOICE' THEN MOBILE END)AS POWER_VOICE_USER,
COUNT(CASE WHEN CUST_SEGMENT='A4.POWER-DATA' THEN MOBILE END)AS POWER_DATA_USER,
2016 AS USAGE_YEAR
FROM TELECOM_2016_SUMMARY 
GROUP BY MOBILE;
QUIT;

/* ================================ */
/* Repeat above for 2017,2018,2019 */

%MACRO MAC(YR=);
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SUMMARY_&YR.
		    DATAFILE='/home/u61735472/BATCH_202203/A8.SAS_MACRO/RAW_DATA/A2.TELECOM YEARLY USAGE DATA.xlsx'
			DBMS=XLSX REPLACE;
			SHEET="USAGE_&YR.";
RUN;		
	
PROC SQL;
CREATE TABLE TELECOMM_SUMMARY AS
SELECT MOBILE,YEARMO,
SUM(MOU) AS TOTAL_VOICE,
SUM(DATA) AS TOTAL_DATA
FROM SUMMARY_&YR.
GROUP BY MOBILE,YEARMO
ORDER BY 1,2;
QUIT;

/* Create segment Data,Voice & Customer segment */
DATA TELECOM_&YR._SUMMARY;
SET TELECOMM_SUMMARY;
IF TOTAL_VOICE>=1000 THEN VOICE_SEGMENT='HV';
ELSE IF TOTAL_VOICE>=500 THEN VOICE_SEGMENT='MV';
ELSE VOICE_SEGMENT='LV';

IF TOTAL_DATA>=20 THEN DATA_SEGMENT='HD';
ELSE IF TOTAL_DATA>=5 THEN DATA_SEGMENT='MD';
ELSE DATA_SEGMENT='LD';

IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='HD' THEN CUST_SEGMENT='A1.BONAFIED';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='MD' THEN CUST_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='MD' THEN CUST_SEGMENT='A2.POWER';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='LD' THEN CUST_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='MV' AND DATA_SEGMENT='HD' THEN CUST_SEGMENT='A2.POWER';
ELSE IF VOICE_SEGMENT='HV' AND DATA_SEGMENT='LD' THEN CUST_SEGMENT='A4.POWER-VOICE';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='LD' THEN CUST_SEGMENT='A5.CASUAL';
ELSE IF VOICE_SEGMENT='LV' AND DATA_SEGMENT='HD' THEN CUST_SEGMENT='A3.POWER-DATA';
ELSE CUST_SEGMENT='A5.CASUAL';
RUN;

/* Get Mobile number(in row) wise count of CUST_SEGMENT(in column) ? */
PROC SQL;
CREATE TABLE MOBILE_USAGE_SUMMARY_&YR. AS 
SELECT MOBILE,
COUNT(CASE WHEN CUST_SEGMENT='A1.BONAFIED' THEN MOBILE END )AS BONAFIED_USER,
COUNT(CASE WHEN CUST_SEGMENT='A5.CASUAL' THEN MOBILE END)AS CASUAL_USER,
COUNT(CASE WHEN CUST_SEGMENT='A2.POWER' THEN MOBILE	END)AS POWER_USER,
COUNT(CASE WHEN CUST_SEGMENT='A4.POWER-VOICE' THEN MOBILE END)AS POWER_VOICE_USER,
COUNT(CASE WHEN CUST_SEGMENT='A4.POWER-DATA' THEN MOBILE END)AS POWER_DATA_USER,
&YR. AS USAGE_YEAR
FROM TELECOM_&YR._SUMMARY 
GROUP BY MOBILE;
QUIT;
%MEND;


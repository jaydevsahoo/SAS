/* %GLOBALS */
/* EX1 */
%LET VARS=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT;
%LET COMP=APPOLO;

%MACRO MAC5;
%GLOBAL X;
%LET X=&COMP.;
DATA MED_&X.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&X.";
%MEND;
%MAC5;

/* EX2 */
%LET X1=GSK;

%MACRO MAC6;
DATA MAC_&X1;
%GLOBAL X;
%LET X=&X1.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&X.";
%MEND;
%MAC6;


DATA MED;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&X.";
RUN;


/* %LOCAL */
%LET COMP=GENO;

%MACRO MAC7;
%LOCAL Y;
%LET Y=&COMP.;
DATA MED_&Y.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&Y.";
%MEND;
%MAC7;

DATA MED;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&Y."; /* LOCAL VARIABLE WILL NOT WORK HERE */
RUN;

/*
%GLOBAL can be called outside macro
%LOCAL can be called only inside macro
*/





LIBNAME SSN8 '/home/u61735472/BATCH_202203/A8.SAS_MACRO/DATASET';RUN;

PROC SQL;
SELECT COUNT(DISTINCT COMPANY) FROM SSN8.MED_2022 ;
QUIT;

/* Using MACRO */
%LET VARS=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT; 

PROC SQL;
SELECT DISTINCT COMPANY 
	INTO : COMP1 - : COMP9
FROM SSN8.MED_2022;
QUIT;

%PUT &COMP7.; 
%PUT &COMP2.;
%PUT &COMP4.;
%PUT &COMP6.;

/* Multiple dataset from one dataset */
DATA M_APPOLO M_CIPLA M_GENO M_OTHERS;
SET SSN8.MED_2022;
IF COMPANY='APPOLO' THEN OUTPUT M_APPOLO;
ELSE IF COMPANY='CIPLA' THEN OUTPUT M_CIPLA;
ELSE IF COMPANY='GENO' THEN OUTPUT M_GENO;
ELSE OUTPUT M_OTHERS;
RUN;

/* Suppose there are thousand , in that case use MACRO */
%MACRO MAC8;
DATA %DO I=1 %TO 9;
	 M_&I.
	 %END;;
SET SSN8.MED_2022;
KEEP &VARS.;
%DO I=1 %TO 9;
 IF COMPANY="&&COMP&I." THEN OUTPUT M_&I.;
%END;
%MEND;
%MAC8;

/* Append all those DATASETS */
%MACRO MAC9;
DATA MED_ALL;
SET %DO I=1 %TO 9;
	M_&I. 
	%END;;	
%MEND;
%MAC9;












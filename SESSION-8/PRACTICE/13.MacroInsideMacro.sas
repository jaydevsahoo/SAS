%MACRO DAILY;
PROC PRINT DATA=SASHELP.CLASS;
RUN;
%MEND;
%DAILY;

%MACRO DAILY_REPORT;
PROC MEANS DATA=SASHELP.CLASS MEAN MAX MIN;
CLASS SEX;
VAR AGE;
TITLE 'Wednesday Report : Summary of Age';
RUN;
%MEND;
%DAILY_REPORT;

%MACRO REPORTING;
%IF &SYSDAY=Wednesday %THEN %DAILY_REPORT;
%ELSE %DAILY;
%MEND;
%REPORTING;

PROC TABULATE DATA=SSN8.MED_2022;
CLASS COMPANY STATE_CODE;
CLASSLEV COMPANY STATE_CODE;
VAR SPENT_AMOUNT;
/* TABLE LAPTOP ALL='TOT_SALES' , COUNTRY*SALES*SUM ALL*SALES*SUM; */
TABLE COMPANY ALL='TOT_SPENT' , STATE_CODE*SPENT_AMOUNT*SUM ALL*SPENT_AMOUNT*SUM;
RUN;














LIBNAME SSN8 '/home/u61735472/BATCH_202203/A8.SAS_MACRO/DATASET';RUN;

/* Defining macro variable using CALL SYMPUT */
/*
1. SYMPUT ->To create macro variable in data step.
2. SYMGET ->To get macro variable in data step.
*/

/* EX-1 */
DATA _NULL_;
CALL SYMPUT('X',PUT(TODAY(),YYMMN6.));
RUN;

%PUT &X.;

DATA PROD_SALES;
INPUT PROD $ YEARMO SALES;
CARDS;
APPLE 202205 800
APPLE 202206 900
APPLE 202207 300
DELL 202205 600
DELL 202206 800
DELL 202207 900
SAMSUNG 202205 680
SAMSUNG 202206 890
SAMSUNG 202207 500
;
RUN;

PROC PRINT DATA=PROD_SALES;
RUN;

/* Q. Retrive data which is most recent YEARMO IN PROD_SALES? */

DATA A;
SET PROD_SALES;
WHERE YEARMO=&X.;
RUN;
PROC PRINT DATA=A;RUN;

/* Q. Retrive ALL data in YEARMO in PROD_SALES? */

DATA _NULL_;
CALL SYMPUT('X',PUT(TODAY(),YYMMN6.));

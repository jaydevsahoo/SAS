/* EX-3 Telecomm usage data
Q. Pull data of current month to last 12 month.
*/
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN8.TELE_USAGE
			DATAFILE='/home/u61735472/BATCH_202203/A8.SAS_MACRO/RAW_DATA/A1.TELECOM_USAGE_DATA.xlsx'
			DBMS=XLSX REPLACE;
RUN;	
		
DATA _NULL_;
CALL SYMPUT('X',PUT(TODAY(),YYMMN6.));
CALL SYMPUT('X12',PUT(INTNX("MONTH",TODAY(),-12),YYMMN6.));
RUN;

%PUT &X.;
%PUT &X12.;

DATA DATA1;
SET SSN8.TELE_USAGE;
WHERE REG_YEARMO BETWEEN &X12. AND &X.;
RUN;
PROC PRINT DATA=DATA1;


/* EX-3 Telecomm usage data
Q. Pull data of current month to last 6,12,18 months.
*/
DATA _NULL_;
CALL SYMPUT('X',PUT(TODAY(),YYMMN6.));
CALL SYMPUT('X6',PUT(INTNX("MONTH",TODAY(),-6),YYMMN6.));
CALL SYMPUT('X12',PUT(INTNX("MONTH",TODAY(),-12),YYMMN6.));
CALL SYMPUT('X18',PUT(INTNX("MONTH",TODAY(),-18),YYMMN6.));
RUN;

%PUT &X.;
%PUT &X6.;
%PUT &X12.;
%PUT &X18.;

DATA DATA6 DATA12 DATA18;
SET SSN8.TELE_USAGE;
IF (&X6.<=REG_YEARMO<=&X.) THEN OUTPUT DATA6;
ELSE IF  (&X12.<=REG_YEARMO<=&X.) THEN OUTPUT DATA12;
ELSE IF (&X18.<=REG_YEARMO<=&X.) THEN OUTPUT DATA18;
RUN;

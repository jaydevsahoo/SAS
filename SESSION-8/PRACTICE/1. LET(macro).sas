LIBNAME SSN8 '/home/u61735472/BATCH_202203/A8.SAS_MACRO/DATASET';RUN;

OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN8.MED_2022
			DATAFILE='/home/u61735472/BATCH_202203/A8.SAS_MACRO/RAW_DATA/MED_STORE_2022.xlsx'
			DBMS=XLSX REPLACE;
			
RUN;			
PROC IMPORT OUT=SSN8.GLOBAL_SALES
			DATAFILE='/home/u61735472/BATCH_202203/A8.SAS_MACRO/RAW_DATA/GLOBAL_SALES_2022.xlsx'
			DBMS=XLSX REPLACE;
			SHEET='Sheet1';
RUN;			
/* using macro */
%LET PATH=/home/u61735472/BATCH_202203/A8.SAS_MACRO/RAW_DATA/;
%LET FILE1=MED_STORE_2022.xlsx;
%LET FILE2=GLOBAL_SALES_2022.xlsx;
OPTION VALIDVARNAME=V7;
PROC IMPORT OUT=SSN8.MED_2022
			DATAFILE="&PATH.&FILE1."
			DBMS=XLSX REPLACE;
RUN;

/* 
%LET is used to create a global macro variable i.e can be called any where any time.
*/

/* EX2 */
DATA MED_APPOLO(KEEP=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT);
SET SSN8.MED_2022;
WHERE COMPANY='APPOLO';
RUN;
DATA MED_CIPLA(KEEP=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT);
SET SSN8.MED_2022;
WHERE COMPANY='CIPLA';
RUN;
DATA MED_OTHERS(KEEP=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT);
SET SSN8.MED_2022;
WHERE COMPANY NOT IN('APPOLO','CIPLA');
RUN;

/* Run above using macro? */
%LET VARS=CUSTOMER_ID COMPANY GENDER AGE STATE_CODE TOWN NO_OF_TRIPS SPENT_AMOUNT;
DATA MED_APPOLO(KEEP=&VARS.);
SET SSN8.MED_2022;
WHERE COMPANY='APPOLO';
RUN;

/* EX-3 */
%LET COMP=APPOLO;
%LET GEN=Male;
%LET AG=50;
%LET SCODE=WA;
DATA MED_&COMP.;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY="&COMP." AND GENDER="&GEN." AND STATE_CODE="&SCODE." AND AGE>&AG.;
RUN;


/* EX-4 */
%LET COMPS="APPOLO","GSK","GENO";
DATA MED_ALL;
SET SSN8.MED_2022;
KEEP &VARS.;
WHERE COMPANY IN (&COMPS.) AND GENDER="&GEN.";
RUN;
/*
MACRO variable names are not case sensitive.
MACRO variable Values are not case sensitive.
*/


































